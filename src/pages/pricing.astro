---
// src/pages/pricing.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tiers & Pricing | Viewport Digital LLC" currentPath="/pricing">
  <div class="space-y-16 sm:space-y-24 pt-12 sm:pt-20 px-4 sm:px-8 max-w-7xl mx-auto pb-16">
    
    <div class="fade-observe space-y-3 text-center max-w-3xl mx-auto">
      <span class="text-xs font-mono tracking-widest text-[#38BDF8] uppercase">Transparent Pricing</span>
      <h1 class="text-3xl sm:text-5xl font-display font-bold text-white tracking-tight">Website Architecture Packages</h1>
      <p class="text-xs sm:text-base text-[#94A3B8]">
        Flat-fee deliverables. Clear turnaround. No endless hourly bills or platform licensing fees.
      </p>
    </div>

    <!-- 3 Website Architecture Packages -->
    <div class="fade-observe grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      
      <!-- Tier 1 -->
      <div class="glass-panel glass-card-interactive p-6 sm:p-8 rounded-2xl flex flex-col justify-between">
        <div class="space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-widest text-[#94A3B8]">Tier 01</span>
            <h2 class="text-xl sm:text-2xl font-display font-bold text-white">The Local Landing Page</h2>
            <p class="text-xs text-[#94A3B8]">Single-page builds, transport fleets, service contractors, or targeted campaigns.</p>
          </div>
          
          <div class="py-4 border-y border-white/[0.08]">
            <span class="text-2xl sm:text-4xl font-display font-bold text-white">$750 – $1,200</span>
            <span class="text-xs font-mono text-[#94A3B8] block mt-1">One-time flat fee</span>
          </div>

          <div class="space-y-3">
            <span class="text-xs font-mono uppercase text-[#CBD5E1] tracking-wider block">Scope of Deliverables:</span>
            <ul class="space-y-2 text-xs text-[#94A3B8]">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                High-impact single page architecture on Astro
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Strict mobile-first responsive layout
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Formspree zero-backend contact integration
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                High-speed edge setup on Vercel
              </li>
            </ul>
          </div>
        </div>

        <div class="pt-6 sm:pt-8 mt-6 border-t border-white/[0.08]">
          <a href="/contact" class="tactile-btn block w-full py-3 text-center text-xs font-bold uppercase tracking-wider text-white bg-[#0F172A] hover:bg-[#2563EB] border border-white/[0.08] hover:border-[#38BDF8] rounded-lg transition-colors">
            Select Tier 1
          </a>
        </div>
      </div>

      <!-- Tier 2 (Core Recommendation) -->
      <div class="glass-panel glass-card-interactive p-6 sm:p-8 rounded-2xl flex flex-col justify-between border-[#38BDF8]/50 shadow-2xl shadow-[#2563EB]/20 relative">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3.5 py-1 bg-[#2563EB] text-white font-mono text-[10px] uppercase font-bold tracking-widest rounded-full border border-[#38BDF8]">
          Core Recommendation
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-widest text-[#38BDF8]">Tier 02</span>
            <h2 class="text-xl sm:text-2xl font-display font-bold text-white">The Multi-Page Core</h2>
            <p class="text-xs text-[#94A3B8]">Established local businesses, clinics, and professional firms needing depth.</p>
          </div>
          
          <div class="py-4 border-y border-white/[0.08]">
            <span class="text-2xl sm:text-4xl font-display font-bold text-white">$1,800 – $3,200</span>
            <span class="text-xs font-mono text-[#94A3B8] block mt-1">One-time flat fee</span>
          </div>

          <div class="space-y-3">
            <span class="text-xs font-mono uppercase text-[#CBD5E1] tracking-wider block">Scope of Deliverables:</span>
            <ul class="space-y-2 text-xs text-[#CBD5E1]">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Up to 5 custom routes (Home, Services, About, Gallery, Contact)
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Seamless commercial photography component integration
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Architectural local SEO metadata & OpenGraph schemas
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Recorded video training & 30-day stabilization buffer
              </li>
            </ul>
          </div>
        </div>

        <div class="pt-6 sm:pt-8 mt-6 border-t border-white/[0.08]">
          <a href="/contact" class="tactile-btn block w-full py-3 text-center text-xs font-bold uppercase tracking-wider text-white bg-[#2563EB] hover:bg-blue-600 rounded-lg shadow-lg shadow-[#2563EB]/30 border border-[#38BDF8]/60">
            Select Tier 2
          </a>
        </div>
      </div>

      <!-- Tier 3 -->
      <div class="glass-panel glass-card-interactive p-6 sm:p-8 rounded-2xl flex flex-col justify-between">
        <div class="space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-widest text-[#94A3B8]">Tier 03</span>
            <h2 class="text-xl sm:text-2xl font-display font-bold text-white">The Custom Portal & App</h2>
            <p class="text-xs text-[#94A3B8]">Interactive onboarding flows, membership portals, and multi-step data collection.</p>
          </div>
          
          <div class="py-4 border-y border-white/[0.08]">
            <span class="text-2xl sm:text-4xl font-display font-bold text-white">$3,500 – $6,500+</span>
            <span class="text-xs font-mono text-[#94A3B8] block mt-1">Based on database & logic depth</span>
          </div>

          <div class="space-y-3">
            <span class="text-xs font-mono uppercase text-[#CBD5E1] tracking-wider block">Scope of Deliverables:</span>
            <ul class="space-y-2 text-xs text-[#94A3B8]">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Astro Server-Side Rendering (SSR) configuration
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Relational Supabase database + secure authentication
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Custom dashboard logic generated via Cursor and Gemini
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#38BDF8] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Sentry error tracking & Resend automated email dispatch
              </li>
            </ul>
          </div>
        </div>

        <div class="pt-6 sm:pt-8 mt-6 border-t border-white/[0.08]">
          <a href="/contact" class="tactile-btn block w-full py-3 text-center text-xs font-bold uppercase tracking-wider text-white bg-[#0F172A] hover:bg-[#2563EB] border border-white/[0.08] hover:border-[#38BDF8] rounded-lg transition-colors">
            Select Tier 3
          </a>
        </div>
      </div>

    </div>

    <!-- Commercial Photography Packages -->
    <div class="fade-observe pt-10 space-y-6">
      <div class="border-t border-white/[0.08] pt-10 text-center md:text-left">
        <span class="text-xs font-mono tracking-widest text-[#38BDF8] uppercase">Optics & Production</span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-white mt-1">Commercial Photography Packages</h2>
        <p class="text-xs sm:text-sm text-[#94A3B8] mt-1">Authentic visual proof captured on-site to give your Astro site undeniable presence.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-panel p-6 rounded-xl space-y-3">
          <div class="flex justify-between items-start">
            <span class="text-xs font-mono text-[#94A3B8]">PACKAGE 01</span>
            <span class="text-xl font-display font-bold text-white">$350</span>
          </div>
          <h3 class="text-base font-bold text-white">The Web Asset Starter</h3>
          <p class="text-xs text-[#94A3B8]">One location, ~1 hour on-site. Clean headshots, storefront curb appeal, 10–15 edited files.</p>
        </div>

        <div class="glass-panel p-6 rounded-xl space-y-3 border-[#38BDF8]/40">
          <div class="flex justify-between items-start">
            <span class="text-xs font-mono text-[#38BDF8]">PACKAGE 02</span>
            <span class="text-xl font-display font-bold text-white">$750</span>
          </div>
          <h3 class="text-base font-bold text-white">The Full Brand Suite</h3>
          <p class="text-xs text-[#94A3B8]">Half-day commitment. Action shots of the crew, interior details, 30–40 polished files.</p>
        </div>

        <div class="glass-panel p-6 rounded-xl space-y-3">
          <div class="flex justify-between items-start">
            <span class="text-xs font-mono text-[#94A3B8]">PACKAGE 03</span>
            <span class="text-xl font-display font-bold text-white">$1,500+</span>
          </div>
          <h3 class="text-base font-bold text-white">Full-Day Commercial Production</h3>
          <p class="text-xs text-[#94A3B8]">Full day on the ground. Multi-room facilities, inventory catalogs, and deep raw archives.</p>
        </div>
      </div>

      <div class="glass-panel p-5 rounded-xl flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono">
        <div class="flex flex-wrap items-center gap-4">
          <span><strong class="text-white">A LA CARTE:</strong> $125 / hour for ad-hoc photo tasks</span>
          <span><strong class="text-white">BUNDLE REBATE:</strong> -$150 off photography with Web Dev</span>
        </div>
        <span class="text-[#38BDF8]">High Value • Full Copyright Release</span>
      </div>
    </div>

    <!-- Structured Website Care Retainers -->
    <div class="fade-observe pt-6 space-y-6">
      <div class="border-t border-white/[0.08] pt-10 text-center md:text-left">
        <span class="text-xs font-mono tracking-widest text-[#38BDF8] uppercase">Ongoing Reliability</span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-white mt-1">Structured Website Care Retainers</h2>
        <p class="text-xs sm:text-sm text-[#94A3B8] mt-1">Optional maintenance buffers. You own the code regardless; these tiers keep updates off your plate.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-panel p-6 rounded-xl space-y-3">
          <div class="flex justify-between items-baseline">
            <h3 class="text-base font-bold text-white">Basic Care</h3>
            <span class="font-mono text-base font-bold text-white">$75 <span class="text-xs text-[#94A3B8]">/mo</span></span>
          </div>
          <p class="text-xs text-[#94A3B8]">Dependency checks, Vercel edge upkeep, uptime monitoring, and 30 mins of minor edits.</p>
        </div>

        <div class="glass-panel p-6 rounded-xl space-y-3 border-[#2563EB]/40">
          <div class="flex justify-between items-baseline">
            <h3 class="text-base font-bold text-white">Growth Retainer</h3>
            <span class="font-mono text-base font-bold text-[#38BDF8]">$150 <span class="text-xs text-[#94A3B8]">/mo</span></span>
          </div>
          <p class="text-xs text-[#94A3B8]">Priority queue response and up to two (2) hours of layout edits or asset swaps per month.</p>
        </div>

        <div class="glass-panel p-6 rounded-xl space-y-3">
          <div class="flex justify-between items-baseline">
            <h3 class="text-base font-bold text-white">Scale Retainer</h3>
            <span class="font-mono text-base font-bold text-white">$300 <span class="text-xs text-[#94A3B8]">/mo</span></span>
          </div>
          <p class="text-xs text-[#94A3B8]">For dynamic portals. Supabase management, same-day bug remediation, and 4 hours of updates.</p>
        </div>
      </div>
    </div>

    <!-- LET'S BUILD CONVERSION ANCHOR -->
    <div class="fade-observe pt-6">
      <div class="glass-panel p-8 sm:p-12 rounded-3xl border border-white/[0.08] relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
        <div class="space-y-3 max-w-xl">
          <span class="text-xs font-mono tracking-widest text-[#38BDF8] uppercase block">Ready to Begin?</span>
          <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight leading-tight">
            Have a project in mind? Let's engineer it.
          </h2>
          <p class="text-xs sm:text-sm text-[#94A3B8] leading-relaxed">
            Zero sales friction. Submit your timeline, tech specs, or required photography assets directly into our dispatch pipeline.
          </p>
        </div>

        <div class="w-full md:w-auto shrink-0">
          <a 
            href="/contact" 
            class="tactile-btn inline-flex items-center justify-center gap-3 w-full md:w-auto px-8 py-4 rounded-xl text-sm font-bold uppercase tracking-wider text-white bg-[#2563EB] hover:bg-blue-600 border border-[#38BDF8]/60 shadow-xl shadow-[#2563EB]/35 transition-all group"
          >
            <span>Let's Build</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>

  </div>
</Layout>
