---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact / Let's Build | Viewport Digital LLC" currentPath="/contact">
  <div class="pt-12 sm:pt-20 px-4 sm:px-8 max-w-4xl mx-auto">
    
    <div class="fade-observe glass-panel p-6 sm:p-12 rounded-3xl border border-white/[0.08] space-y-8 relative overflow-hidden">
      
      <div class="text-center space-y-3">
        <span class="text-xs font-mono tracking-widest text-[#38BDF8] uppercase">Zero Dead-End Architecture</span>
        <h1 class="text-2xl sm:text-4xl font-display font-bold text-white">Initiate Your Build Specifications</h1>
        <p class="text-xs sm:text-sm text-[#94A3B8] max-w-lg mx-auto">
          Direct communication with the engineer and photographer. No account managers or sales runarounds.
        </p>
      </div>

      <form class="space-y-6" onsubmit="event.preventDefault(); alert('Inquiry logged into Viewport Digital dispatch pipeline.');">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <div class="space-y-2">
            <label class="block text-xs font-mono uppercase tracking-wider text-[#CBD5E1]">Your Name</label>
            <input type="text" required placeholder="Jane Doe" class="w-full px-4 py-3 rounded-lg bg-[#0B0F19] border border-white/[0.08] text-white text-sm focus:outline-none focus:border-[#38BDF8] transition-colors" />
          </div>
          <div class="space-y-2">
            <label class="block text-xs font-mono uppercase tracking-wider text-[#CBD5E1]">Email Address</label>
            <input type="email" required placeholder="jane@company.com" class="w-full px-4 py-3 rounded-lg bg-[#0B0F19] border border-white/[0.08] text-white text-sm focus:outline-none focus:border-[#38BDF8] transition-colors" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <div class="space-y-2">
            <label class="block text-xs font-mono uppercase tracking-wider text-[#CBD5E1]">Target Web Tier</label>
            <select class="w-full px-4 py-3 rounded-lg bg-[#0B0F19] border border-white/[0.08] text-white text-sm focus:outline-none focus:border-[#38BDF8] transition-colors">
              <option>Tier 1: Landing Page ($750 - $1,200)</option>
              <option selected>Tier 2: Business Core ($1,800 - $3,200)</option>
              <option>Tier 3: Custom Portal ($3,500 - $6,500+)</option>
              <option>A La Carte / Custom Architecture</option>
            </select>
          </div>
          <div class="space-y-2">
            <label class="block text-xs font-mono uppercase tracking-wider text-[#CBD5E1]">Commercial Photography Add-on</label>
            <select class="w-full px-4 py-3 rounded-lg bg-[#0B0F19] border border-white/[0.08] text-white text-sm focus:outline-none focus:border-[#38BDF8] transition-colors">
              <option>Starter Suite ($350 - $150 bundle rebate)</option>
              <option selected>Full Brand Suite ($750 - $150 bundle rebate)</option>
              <option>Full-Day Production ($1,500+)</option>
              <option>No Photography Needed</option>
            </select>
          </div>
        </div>

        <div class="space-y-2">
          <label class="block text-xs font-mono uppercase tracking-wider text-[#CBD5E1]">Project Scope & Objectives</label>
          <textarea rows="4" required placeholder="Describe your current site bottlenecks, workflow goals, or required integrations..." class="w-full px-4 py-3 rounded-lg bg-[#0B0F19] border border-white/[0.08] text-white text-sm focus:outline-none focus:border-[#38BDF8] transition-colors"></textarea>
        </div>

        <button type="submit" class="tactile-btn w-full py-4 text-center text-sm font-bold uppercase tracking-wider text-white bg-[#2563EB] hover:bg-blue-600 rounded-xl shadow-xl shadow-[#2563EB]/30 border border-[#38BDF8]/50">
          Submit Specifications to Viewport Digital
        </button>
      </form>

      <div class="text-center pt-2">
        <span class="text-xs font-mono text-[#94A3B8]">White-glove handover included: Video docs, Git repository push, and 30-day warranty.</span>
      </div>

    </div>

  </div>
</Layout>
