---
// src/pages/process.astro
// Viewport Digital LLC - Process / Modern Stack Ecosystem
import Layout from '../layouts/Layout.astro';
---

<Layout title="Modern Stack Ecosystem | Viewport Digital LLC" currentPath="/process">
  <div class="pt-8 sm:pt-16 pb-16 px-4 sm:px-8 max-w-7xl mx-auto">
    
    <div class="fade-observe glass-panel p-6 sm:p-12 rounded-3xl border border-white/[0.08] relative overflow-hidden">
      
      <!-- Section Header -->
      <div class="max-w-3xl space-y-4 mb-10 text-left">
        <span class="text-xs font-mono tracking-widest text-[#38BDF8] uppercase block">
          MODERN STACK ECOSYSTEM
        </span>
        <h1 class="text-3xl sm:text-5xl font-display font-bold text-white tracking-tight leading-tight">
          Purpose-Built Infrastructure
        </h1>
        <p class="text-sm sm:text-base text-[#94A3B8] leading-relaxed max-w-2xl">
          Every layer of your build is selected for zero bloat, sub-second execution, enterprise-tier security, and clean developer ergonomics.
        </p>
      </div>

      <!-- Purpose-Built Infrastructure Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 font-mono">
        
        <!-- Astro -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#0B0F19]/80 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[#38BDF8] text-xs font-bold mb-3 tracking-wider">
              <span>ASTRO</span>
              <span class="text-[11px] font-normal text-[#94A3B8]">RENDER CORE</span>
            </div>
            <p class="text-xs sm:text-sm text-[#CBD5E1] leading-relaxed font-sans">
              Handles lightning-fast static rendering by stripping away client-side JS by default for raw HTML delivery.
            </p>
          </div>
        </div>

        <!-- Vercel -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#0B0F19]/80 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[#38BDF8] text-xs font-bold mb-3 tracking-wider">
              <span>VERCEL</span>
              <span class="text-[11px] font-normal text-[#94A3B8]">EDGE COMPUTE</span>
            </div>
            <p class="text-xs sm:text-sm text-[#CBD5E1] leading-relaxed font-sans">
              Powers instant global edge deployments, auto-routing your visitors to the nearest data center node.
            </p>
          </div>
        </div>

        <!-- Cursor + Gemini -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#0B0F19]/80 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[#38BDF8] text-xs font-bold mb-3 tracking-wider">
              <span>CURSOR + GEMINI</span>
              <span class="text-[11px] font-normal text-[#94A3B8]">SYNTHESIS</span>
            </div>
            <p class="text-xs sm:text-sm text-[#CBD5E1] leading-relaxed font-sans">
              Drives clean workspace code generation, eliminating human error across boilerplate and schema definitions.
            </p>
          </div>
        </div>

        <!-- GitHub -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#0B0F19]/80 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[#38BDF8] text-xs font-bold mb-3 tracking-wider">
              <span>GITHUB</span>
              <span class="text-[11px] font-normal text-[#94A3B8]">VERSION CONTROL</span>
            </div>
            <p class="text-xs sm:text-sm text-[#CBD5E1] leading-relaxed font-sans">
              Anchors version control and provides full transparency. You hold the master branch keys forever.
            </p>
          </div>
        </div>

        <!-- Tailwind CSS -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#0B0F19]/80 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[#38BDF8] text-xs font-bold mb-3 tracking-wider">
              <span>TAILWIND CSS</span>
              <span class="text-[11px] font-normal text-[#94A3B8]">DESIGN SYSTEM</span>
            </div>
            <p class="text-xs sm:text-sm text-[#CBD5E1] leading-relaxed font-sans">
              Styles the UI through strict atomic token sets without runtime styling engine bottlenecks.
            </p>
          </div>
        </div>

        <!-- Supabase -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#0B0F19]/80 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[#38BDF8] text-xs font-bold mb-3 tracking-wider">
              <span>SUPABASE</span>
              <span class="text-[11px] font-normal text-[#94A3B8]">RELATIONAL DATA</span>
            </div>
            <p class="text-xs sm:text-sm text-[#CBD5E1] leading-relaxed font-sans">
              Handles database scaling, user auth pools, and PostgreSQL storage when dynamic portals are required.
            </p>
          </div>
        </div>

        <!-- Sentry -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#0B0F19]/80 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[#38BDF8] text-xs font-bold mb-3 tracking-wider">
              <span>SENTRY</span>
              <span class="text-[11px] font-normal text-[#94A3B8]">TELEMETRY</span>
            </div>
            <p class="text-xs sm:text-sm text-[#CBD5E1] leading-relaxed font-sans">
              Catches production errors and client performance regressions before customers notice them.
            </p>
          </div>
        </div>

        <!-- Resend -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#0B0F19]/80 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[#38BDF8] text-xs font-bold mb-3 tracking-wider">
              <span>RESEND</span>
              <span class="text-[11px] font-normal text-[#94A3B8]">COMMUNICATIONS</span>
            </div>
            <p class="text-xs sm:text-sm text-[#CBD5E1] leading-relaxed font-sans">
              Manages transactional lead alerts and customer confirmation emails with 99.9% inbox deliverability.
            </p>
          </div>
        </div>

        <!-- Cloudflare -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#0B0F19]/80 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[#38BDF8] text-xs font-bold mb-3 tracking-wider">
              <span>CLOUDFLARE</span>
              <span class="text-[11px] font-normal text-[#94A3B8]">SECURITY & DNS</span>
            </div>
            <p class="text-xs sm:text-sm text-[#CBD5E1] leading-relaxed font-sans">
              Locks down the DNS edge with enterprise DDoS mitigation and high-speed SSL cert rotation.
            </p>
          </div>
        </div>

      </div>

      <!-- Action Anchor -->
      <div class="mt-12 pt-8 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4">
        <span class="text-xs font-mono text-[#94A3B8]">
          READY TO DEPLOY ARCHITECTURE?
        </span>
        <a href="/pricing" class="tactile-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#2563EB] hover:bg-blue-600 border border-[#38BDF8]/50 shadow-lg shadow-[#2563EB]/25">
          <span>View Tiers & Pricing</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>

  </div>
</Layout>
