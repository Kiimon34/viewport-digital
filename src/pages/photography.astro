---
// src/pages/photography.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Viewport Photography | Portraits, Weddings & Events">
  <header class="fixed top-0 left-0 right-0 z-50 bg-slate-950/90 backdrop-blur-xl border-b border-white/10">
    <div class="max-w-7xl mx-auto px-8 h-28 flex items-center justify-between">
      <a href="/" class="flex items-center gap-5 group">
        <div class="bg-white p-3.5 rounded-2xl shadow-2xl">
          <img src="/logo.png" alt="Viewport Digital LLC" class="h-14 md:h-16 w-auto object-contain" />
        </div>
        <div class="flex flex-col">
          <span class="font-black tracking-tight text-white text-xl">VIEWPORT PHOTOGRAPHY</span>
          <span class="text-xs uppercase font-mono tracking-widest text-cyan-400">Portraits • Weddings • Stories</span>
        </div>
      </a>
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
        <a href="/" class="hover:text-cyan-400 transition">Web & Commercial</a>
        <a href="/photography" class="text-cyan-400 font-semibold">Portraits & Weddings</a>
        <a href="#pricing-photo" class="bg-cyan-500 text-slate-950 px-6 py-3 rounded-xl hover:bg-cyan-400 transition font-bold">Book a Session</a>
      </nav>
    </div>
  </header>

  <main class="bg-slate-950 text-slate-100 min-h-screen pt-36">
    <!-- Editorial Gallery Hero -->
    <section class="py-20 px-8 max-w-6xl mx-auto text-center">
      <span class="text-xs tracking-widest uppercase text-cyan-400 font-mono mb-3 block">Visual Storytelling Studio</span>
      <h1 class="text-5xl sm:text-7xl lg:text-8xl font-black tracking-tighter uppercase mb-6">
        Captured <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-white">Moments.</span>
      </h1>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto font-light">
        From golden hour family sessions at Tarkington Park to intimate central Indiana weddings. Real light, genuine emotion, and timeless framing.
      </p>
    </section>

    <!-- Gallery Grid Presentation -->
    <section class="py-12 px-8 max-w-7xl mx-auto">
      <div class="grid md:grid-cols-3 gap-6">
        <div class="aspect-[4/5] bg-slate-900 rounded-3xl border border-white/10 relative overflow-hidden flex items-end p-8 group">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent z-10"></div>
          <div class="relative z-20">
            <span class="text-xs font-mono text-cyan-400 uppercase">Portraits & Family</span>
            <h3 class="text-2xl font-bold text-white mt-1">Parks & Open Air</h3>
          </div>
        </div>
        <div class="aspect-[4/5] bg-slate-900 rounded-3xl border border-white/10 relative overflow-hidden flex items-end p-8 group">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent z-10"></div>
          <div class="relative z-20">
            <span class="text-xs font-mono text-cyan-400 uppercase">Weddings & Elopements</span>
            <h3 class="text-2xl font-bold text-white mt-1">Florence & Local Ceremonies</h3>
          </div>
        </div>
        <div class="aspect-[4/5] bg-slate-900 rounded-3xl border border-white/10 relative overflow-hidden flex items-end p-8 group">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent z-10"></div>
          <div class="relative z-20">
            <span class="text-xs font-mono text-cyan-400 uppercase">Private Events</span>
            <h3 class="text-2xl font-bold text-white mt-1">Milestones & Gatherings</h3>
          </div>
        </div>
      </div>
    </section>

    <!-- Photography Pricing Matrix -->
    <section id="pricing-photo" class="py-32 px-8 max-w-7xl mx-auto border-t border-white/10">
      <div class="text-center mb-20">
        <span class="text-xs tracking-widest uppercase text-cyan-400 font-mono mb-3 block">Direct Bookings</span>
        <h2 class="text-4xl md:text-6xl font-black tracking-tight text-white uppercase">Photography Pricing</h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 mb-16">
        <!-- Family & Portraits -->
        <div class="bg-slate-900/40 border border-white/10 p-10 rounded-3xl backdrop-blur-xl">
          <h3 class="text-2xl font-bold text-white mb-6 flex items-center justify-between">
            Family & Portrait Sessions
          </h3>
          <div class="space-y-8">
            <div class="border-b border-white/10 pb-6">
              <div class="flex justify-between items-baseline mb-2">
                <h4 class="text-lg font-bold text-white">The Essentials Mini-Session</h4>
                <span class="text-2xl font-black text-cyan-400">$175</span>
              </div>
              <p class="text-sm text-slate-400 font-light">30-minute block at a single local spot like Tarkington Park or clean outdoor backdrop. 10 to 15 polished digital files via online gallery.</p>
            </div>
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <h4 class="text-lg font-bold text-white">The Full Family Story</h4>
                <span class="text-2xl font-black text-cyan-400">$325</span>
              </div>
              <p class="text-sm text-slate-400 font-light">Up to 90 minutes, multiple outfit swaps, coverage for up to 5 family members ($25 per extra person), and 30 to 40 fully edited images.</p>
            </div>
          </div>
        </div>

        <!-- Weddings & Events -->
        <div class="bg-slate-900/40 border border-white/10 p-10 rounded-3xl backdrop-blur-xl">
          <h3 class="text-2xl font-bold text-white mb-6 flex items-center justify-between">
            Weddings & Private Events
          </h3>
          <div class="space-y-8">
            <div class="border-b border-white/10 pb-6">
              <div class="flex justify-between items-baseline mb-2">
                <h4 class="text-lg font-bold text-white">Intimate & Elopement Tier</h4>
                <span class="text-2xl font-black text-cyan-400">$1,200</span>
              </div>
              <p class="text-sm text-slate-400 font-light">Up to 4 hours of coverage for courthouse ceremonies or smaller gatherings around central Indiana. Complete digital delivery.</p>
            </div>
            <div class="border-b border-white/10 pb-6">
              <div class="flex justify-between items-baseline mb-2">
                <h4 class="text-lg font-bold text-white">Full-Day Wedding Package</h4>
                <span class="text-2xl font-black text-cyan-400">$2,200</span>
              </div>
              <p class="text-sm text-slate-400 font-light">Up to 8 hours of wedding day storytelling, timeline planning assistance, and full high-resolution digital gallery download.</p>
            </div>
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <h4 class="text-lg font-bold text-white">Hourly Event Coverage</h4>
                <span class="text-2xl font-black text-cyan-400">$150/hr</span>
              </div>
              <p class="text-sm text-slate-400 font-light">2-hour minimum booking. Built for birthday parties, milestones, and family reunions with rapid turnaround.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Form -->
    <section class="py-32 px-8 max-w-3xl mx-auto border-t border-white/10">
      <div class="text-center mb-14">
        <h2 class="text-4xl font-black text-white uppercase tracking-tight mb-3">Book Your Session</h2>
        <p class="text-slate-400 font-light">Secure your date on the photography calendar.</p>
      </div>
      
      <form action="https://formspree.io/f/xyeyllbk" method="POST" class="space-y-6 bg-slate-900/40 border border-white/10 p-10 md:p-14 rounded-3xl backdrop-blur-xl">
        <div>
          <label class="block text-xs uppercase font-mono tracking-wider mb-2.5 text-slate-400" for="name">Your Name</label>
          <input type="text" id="name" name="name" required class="w-full bg-slate-950 border border-white/10 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white" />
        </div>
        <div>
          <label class="block text-xs uppercase font-mono tracking-wider mb-2.5 text-slate-400" for="email">Email Address</label>
          <input type="email" id="email" name="_replyto" required class="w-full bg-slate-950 border border-white/10 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white" />
        </div>
        <div>
          <label class="block text-xs uppercase font-mono tracking-wider mb-2.5 text-slate-400" for="session">Select Package / Session Type</label>
          <textarea id="session" name="message" rows="4" required class="w-full bg-slate-950 border border-white/10 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white resize-none" placeholder="Mini-session, Full Family Story, Wedding Tier, etc..."></textarea>
        </div>
        <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold py-5 rounded-2xl transition text-lg tracking-wide uppercase">Request Booking</button>
      </form>
    </section>
  </main>
</Layout>
