---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Viewport Digital LLC | Engineered Digital Architecture" currentPath="/">
  <div class="space-y-20 sm:space-y-28 pt-12 sm:pt-20 px-4 sm:px-8 max-w-7xl mx-auto">
    
    <!-- Hero Section -->
    <section class="fade-observe flex flex-col items-center text-center max-w-4xl mx-auto space-y-6 sm:space-y-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F172A]/80 border border-white/[0.08] text-[11px] font-mono tracking-widest uppercase text-[#94A3B8]">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>Bespoke Engineering & Authentic Optics</span>
      </div>

      <h1 class="text-3xl sm:text-6xl md:text-7xl font-display font-bold tracking-[-0.03em] leading-[1.08] text-white">
        Own your digital footprint. <br />
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#CBD5E1] via-[#38BDF8] to-[#2563EB]">
          No templates. No monthly rent.
        </span>
      </h1>

      <p class="text-sm sm:text-lg text-[#94A3B8] leading-relaxed max-w-[650px]">
        Most agencies lease you bloated WordPress themes on life support. Viewport Digital writes high-performance static architecture on Astro, paired with bespoke commercial photography that captures real physical substance.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-4 pt-2 w-full sm:w-auto">
        <a href="/process" class="tactile-btn w-full sm:w-auto px-8 py-4 rounded-xl text-sm font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#2563EB] to-blue-700 hover:from-blue-600 hover:to-blue-800 border border-[#38BDF8]/40 shadow-xl shadow-[#2563EB]/30 text-center">
          Our Process
        </a>
        <a href="/pricing" class="tactile-btn w-full sm:w-auto px-8 py-4 rounded-xl text-sm font-semibold tracking-wider text-[#CBD5E1] hover:text-white glass-panel border border-white/[0.08] hover:border-white/20 text-center">
          View Tiers & Pricing
        </a>
      </div>

      <!-- 4 Core Performance Metrics -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full pt-10 text-left">
        <div class="glass-panel p-4 sm:p-5 rounded-xl">
          <span class="font-mono text-xs text-[#94A3B8] block">RENDER TIME</span>
          <span class="font-display text-xl sm:text-2xl font-bold text-white">&lt; 350ms</span>
          <p class="text-[11px] sm:text-xs text-[#94A3B8] mt-1">Edge distribution via Vercel</p>
        </div>
        <div class="glass-panel p-4 sm:p-5 rounded-xl">
          <span class="font-mono text-xs text-[#94A3B8] block">CODE OWNERSHIP</span>
          <span class="font-display text-xl sm:text-2xl font-bold text-[#38BDF8]">100%</span>
          <p class="text-[11px] sm:text-xs text-[#94A3B8] mt-1">Stored in your GitHub repo</p>
        </div>
        <div class="glass-panel p-4 sm:p-5 rounded-xl">
          <span class="font-mono text-xs text-[#94A3B8] block">MONTHLY RENT</span>
          <span class="font-display text-xl sm:text-2xl font-bold text-emerald-400">$0.00</span>
          <p class="text-[11px] sm:text-xs text-[#94A3B8] mt-1">Zero mandatory site fees</p>
        </div>
        <div class="glass-panel p-4 sm:p-5 rounded-xl">
          <span class="font-mono text-xs text-[#94A3B8] block">VISUAL ASSETS</span>
          <span class="font-display text-xl sm:text-2xl font-bold text-white">Full Raw/Edit</span>
          <p class="text-[11px] sm:text-xs text-[#94A3B8] mt-1">Authentic commercial photography</p>
        </div>
      </div>
    </section>

    <!-- Engineering Contrast Section -->
    <section class="space-y-8">
      <div class="fade-observe space-y-3 text-center md:text-left">
        <span class="text-xs font-mono tracking-widest text-[#38BDF8] uppercase">Engineering Contrast</span>
        <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">The Reality Gap: Engineered Code vs. Subscription Clutter</h2>
        <p class="text-[#94A3B8] max-w-2xl text-sm sm:text-base">
          Wix, Squarespace, and bloated CMS builds hold your domain hostage while bleeding recurring cash. Here is the concrete technical breakdown.
        </p>
      </div>

      <div class="fade-observe grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-panel p-6 sm:p-8 rounded-2xl relative flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-xs font-mono uppercase text-[#38BDF8]">Structural Model</span>
            <h3 class="text-xl font-display font-bold text-white">Engineered vs. Template</h3>
            <p class="text-xs sm:text-sm text-[#94A3B8]">Templates load 40 unused JS libraries and brittle layout builders that collapse across viewports.</p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/[0.08] text-xs text-white flex items-center gap-2">
            <svg class="w-4 h-4 text-[#38BDF8] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            100/100 Google Lighthouse metric
          </div>
        </div>

        <div class="glass-panel p-6 sm:p-8 rounded-2xl relative flex flex-col justify-between border-[#2563EB]/40">
          <div class="space-y-3">
            <span class="text-xs font-mono uppercase text-[#38BDF8]">Financial Model</span>
            <h3 class="text-xl font-display font-bold text-white">Flat Fee vs. Subscription</h3>
            <p class="text-xs sm:text-sm text-[#94A3B8]">Agencies trap you in $200–$500/month recurring fees. Stop paying rent for plain text.</p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/[0.08] text-xs text-white flex items-center gap-2">
            <svg class="w-4 h-4 text-[#38BDF8] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Pay once, own the asset outright
          </div>
        </div>

        <div class="glass-panel p-6 sm:p-8 rounded-2xl relative flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-xs font-mono uppercase text-[#38BDF8]">Asset Control</span>
            <h3 class="text-xl font-display font-bold text-white">Ownership vs. Renting</h3>
            <p class="text-xs sm:text-sm text-[#94A3B8]">If your SaaS host hikes pricing, your site vanishes. Viewport delivers pure code for your Git repo.</p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/[0.08] text-xs text-white flex items-center gap-2">
            <svg class="w-4 h-4 text-[#38BDF8] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Full repository and DNS transfer
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
