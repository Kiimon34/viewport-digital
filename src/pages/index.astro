---
// Viewport Digital LLC - Steve Jobs Minimalist Build
// Stack: Astro, Vercel
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Viewport Digital LLC — High-Performance Web Infrastructure & Media</title>
		<style>
			:root {
				color-scheme: dark;
			}
			* {
				box-sizing: border-box;
				letter-spacing: -0.015em;
			}
			body {
				margin: 0;
				font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				background-color: #000000;
				color: #f5f5f7;
				line-height: 1.47059;
				font-weight: 400;
				-webkit-font-smoothing: antialiased;
			}
			header {
				position: sticky;
				top: 0;
				z-index: 100;
				backdrop-filter: blur(20px);
				-webkit-backdrop-filter: blur(20px);
				background-color: rgba(0, 0, 0, 0.8);
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
			}
			.container {
				max-width: 1024px;
				margin: 0 auto;
				padding: 0 32px;
			}
			.header-content {
				display: flex;
				align-items: center;
				justify-content: space-between;
				height: 52px;
			}
			.logo {
				font-weight: 600;
				font-size: 0.95rem;
				letter-spacing: -0.01em;
				color: #f5f5f7;
				text-decoration: none;
			}
			.logo span {
				color: #86868b;
				font-weight: 400;
			}
			nav {
				display: flex;
				gap: 32px;
				font-size: 0.8rem;
				color: #86868b;
			}
			nav a {
				color: #86868b;
				text-decoration: none;
				transition: color 0.2s ease;
			}
			nav a:hover { color: #f5f5f7; }
			
			.btn-apple {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 8px 16px;
				border-radius: 980px;
				background-color: #f5f5f7;
				color: #000000;
				font-weight: 400;
				font-size: 0.8rem;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			.btn-apple:hover { background-color: #ffffff; transform: scale(1.02); }

			.btn-apple-outline {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 12px 24px;
				border-radius: 980px;
				background-color: transparent;
				border: 1px solid rgba(255, 255, 255, 0.3);
				color: #f5f5f7;
				font-weight: 400;
				font-size: 0.9rem;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			.btn-apple-outline:hover { background-color: rgba(255, 255, 255, 0.08); border-color: #f5f5f7; }

			/* Hero Section */
			.hero {
				padding: 140px 0 100px 0;
				text-align: center;
			}
			.hero-super {
				font-size: 0.85rem;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: #86868b;
				margin-bottom: 16px;
			}
			h1 {
				font-size: clamp(3rem, 7vw, 5.5rem);
				font-weight: 600;
				letter-spacing: -0.03em;
				line-height: 1.05;
				color: #f5f5f7;
				margin: 0 0 24px 0;
			}
			.hero-p {
				max-width: 580px;
				margin: 0 auto 48px auto;
				font-size: 1.25rem;
				color: #86868b;
				line-height: 1.5;
				font-weight: 400;
			}
			.hero-actions {
				display: flex;
				gap: 16px;
				justify-content: center;
				align-items: center;
			}

			/* Sections */
			section {
				padding: 120px 0;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
			}
			.section-header {
				text-align: center;
				max-width: 640px;
				margin: 0 auto 80px auto;
			}
			.section-header h2 {
				font-size: clamp(2.25rem, 4vw, 3.5rem);
				font-weight: 600;
				letter-spacing: -0.02em;
				color: #f5f5f7;
				margin: 0 0 16px 0;
			}
			.section-header p {
				color: #86868b;
				font-size: 1.1rem;
				line-height: 1.5;
			}

			/* Flagship Product Card */
			.product-card {
				background: #111113;
				border: 1px solid rgba(255, 255, 255, 0.12);
				border-radius: 28px;
				padding: 64px 48px;
				position: relative;
				overflow: hidden;
				display: grid;
				grid-template-columns: 1fr;
				gap: 48px;
			}
			@media(min-width: 768px) {
				.product-card { grid-template-columns: 1.2fr 0.8fr; align-items: center; }
			}
			.product-title {
				font-size: 2.25rem;
				font-weight: 600;
				color: #f5f5f7;
				margin: 12px 0 16px 0;
				letter-spacing: -0.02em;
			}
			.product-price {
				font-size: 2.75rem;
				font-weight: 600;
				color: #f5f5f7;
				margin-bottom: 24px;
				letter-spacing: -0.02em;
			}
			.specs-list {
				list-style: none;
				padding: 0;
				margin: 0 0 32px 0;
				font-size: 0.95rem;
				color: #86868b;
			}
			.specs-list li {
				padding: 10px 0;
				border-bottom: 1px solid rgba(255, 255, 255, 0.06);
				display: flex;
				align-items: center;
				gap: 12px;
			}
			.specs-list li::before {
				content: "—";
				color: #f5f5f7;
			}

			/* Grid Two */
			.grid-2 {
				display: grid;
				grid-template-columns: 1fr;
				gap: 32px;
			}
			@media(min-width: 768px) {
				.grid-2 { grid-template-columns: repeat(2, 1fr); }
			}
			.minimal-card {
				background: #111113;
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 24px;
				padding: 48px;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			/* Comparison */
			.comparison-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 32px;
			}
			@media(min-width: 768px) {
				.comparison-grid { grid-template-columns: repeat(2, 1fr); }
			}
			.compare-col {
				background: #111113;
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 24px;
				padding: 48px;
			}

			/* Contact */
			.contact-wrap {
				max-width: 560px;
				margin: 0 auto;
				background: #111113;
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 24px;
				padding: 48px;
			}
			.form-group {
				margin-bottom: 24px;
			}
			label {
				display: block;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #86868b;
				margin-bottom: 8px;
			}
			input, textarea {
				width: 100%;
				padding: 14px 16px;
				border-radius: 12px;
				background-color: #000000;
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: #f5f5f7;
				font-size: 0.95rem;
				box-sizing: border-box;
				outline: none;
				transition: border-color 0.2s ease;
			}
			input:focus, textarea:focus { border-color: #f5f5f7; }

			footer {
				padding: 60px 0;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				text-align: center;
				color: #86868b;
				font-size: 0.8rem;
			}
		</style>
	</head>
	<body>

		<!-- Header -->
		<header>
			<div class="container header-content">
				<a href="/" class="logo">Viewport Digital <span>LLC</span></a>
				<nav>
					<a href="#flagship">Core Offer</a>
					<a href="/pricing">All Tiers</a>
					<a href="/photography">Media</a>
				</nav>
				<div>
					<a href="#contact" class="btn-apple">Inquire</a>
				</div>
			</div>
		</header>

		<main>
			<!-- Hero Section -->
			<section class="hero" style="border-top: none; padding-top: 100px;">
				<div class="container">
					<div class="hero-super">Viewport Digital LLC — Carmel, Indiana</div>
					<h1>Code. Capture. Convert.</h1>
					<p class="hero-p">
						High-performance web infrastructure and commercial media built with absolute precision. Zero bloat. Pure speed.
					</p>
					<div class="hero-actions">
						<a href="#flagship" class="btn-apple" style="padding: 14px 28px; font-size: 0.95rem;">Explore Build</a>
						<a href="/pricing" class="btn-apple-outline">View Pricing</a>
					</div>
				</div>
			</section>

			<!-- Flagship Product Card (Tier 2 Spotlight) -->
			<section id="flagship">
				<div class="container">
					<div class="section-header">
						<h2>Engineered without compromise.</h2>
						<p>Our flagship solution designed for businesses that refuse to blend in.</p>
					</div>

					<div class="product-card">
						<div>
							<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #86868b; margin-bottom: 8px;">Flagship Standard</div>
							<h3 class="product-title">Multi-Page Business Core</h3>
							<div class="product-price">$1,800 – $3,200</div>
							<p style="color: #86868b; font-size: 1.05rem; line-height: 1.5; margin-bottom: 32px;">
								Built from the metal up using Astro and Vercel. Instantaneous load times, pristine mobile responsiveness, and total architectural ownership.
							</p>
							<ul class="specs-list">
								<li>Up to 5 custom semantic pages</li>
								<li>Integrated commercial photography assets</li>
								<li>Blazing-fast Vercel edge deployment</li>
								<li>Top-tier SEO metadata configuration</li>
							</ul>
						</div>
						<div style="display: flex; flex-direction: column; gap: 16px; justify-content: center; background: rgba(0,0,0,0.4); padding: 36px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.06);">
							<div style="font-size: 0.9rem; color: #f5f5f7; font-weight: 500;">Ready to deploy?</div>
							<p style="font-size: 0.85rem; color: #86868b; margin: 0;">Secure your build slot with our foundational partner rate.</p>
							<a href="#contact" class="btn-apple" style="padding: 14px; text-align: center; font-size: 0.9rem; margin-top: 8px;">Initiate Project</a>
							<a href="/pricing" style="text-align: center; color: #86868b; font-size: 0.8rem; text-decoration: none; margin-top: 4px;" class="hover:text-white">Compare all tiers &rarr;</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Commercial Media Tease -->
			<section>
				<div class="container">
					<div class="grid-2">
						<div class="minimal-card">
							<div>
								<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #86868b; margin-bottom: 8px;">Visual Assets</div>
								<h3 style="font-size: 1.8rem; font-weight: 600; color: #f5f5f7; margin: 0 0 16px 0;">Commercial Media Production</h3>
								<p style="color: #86868b; font-size: 0.95rem; line-height: 1.5; margin-bottom: 24px;">
									Ditch generic stock photography. We capture authentic workspace textures and brand assets engineered specifically for your layout.
								</p>
							</div>
							<div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 24px;">
								<span style="font-size: 0.85rem; color: #34c759; font-weight: 500;">Save $150 with web bundle</span>
								<a href="/photography" class="btn-apple" style="padding: 8px 16px;">View Suites</a>
							</div>
						</div>

						<div class="minimal-card">
							<div>
								<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #86868b; margin-bottom: 8px;">Full Brand Suite</div>
								<h3 style="font-size: 1.8rem; font-weight: 600; color: #f5f5f7; margin: 0 0 16px 0;">$750 flat</h3>
								<p style="color: #86868b; font-size: 0.95rem; line-height: 1.5; margin-bottom: 24px;">
									Half-day commitment. 30 to 40 fully edited, web-optimized files delivered directly to your project repository.
								</p>
							</div>
							<div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 24px;">
								<a href="/photography" style="color: #f5f5f7; font-size: 0.85rem; text-decoration: none;" class="hover:underline">Explore all packages &rarr;</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Ownership vs Subscription Traps -->
			<section>
				<div class="container">
					<div class="section-header">
						<h2>Absolute control. Zero friction.</h2>
						<p>Why custom architecture outperforms mainstream builders.</p>
					</div>

					<div class="comparison-grid">
						<div class="compare-col">
							<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #ff453a; margin-bottom: 8px;">The Legacy Trap</div>
							<h3 style="font-size: 1.5rem; font-weight: 600; color: #f5f5f7; margin: 0 0 16px 0;">GoDaddy & Wix</h3>
							<p style="color: #86868b; font-size: 0.95rem; line-height: 1.6; margin: 0;">
								Endless monthly subscriptions for bloated templates that choke on mobile devices, tank search rankings, and leave you stranded with automated customer service loops.
							</p>
						</div>

						<div class="compare-col" style="border-color: rgba(52, 199, 89, 0.4);">
							<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #34c759; margin-bottom: 8px;">The Viewport Standard</div>
							<h3 style="font-size: 1.5rem; font-weight: 600; color: #f5f5f7; margin: 0 0 16px 0;">True Ownership</h3>
							<p style="color: #86868b; font-size: 0.95rem; line-height: 1.6; margin: 0;">
								You own the code. High-speed Astro static rendering, edge deployment via Vercel, and direct partnership with a local engineer in Carmel, Indiana[span_0](start_span)[span_0](end_span).
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Contact / Inquiry Section -->
			<section id="contact">
				<div class="container">
					<div class="section-header">
						<h2>Start your build.</h2>
						<p>Initiate a project or schedule a consultation directly.</p>
					</div>

					<div class="contact-wrap">
						<form action="https://formspree.io/f/xlgpqvaz" method="POST">
							<div class="form-group">
								<label>Your Name</label>
								<input type="text" name="name" required placeholder="Jane Doe" />
							</div>
							<div class="form-group">
								<label>Email Address</label>
								<input type="email" name="email" required placeholder="jane@company.com" />
							</div>
							<div class="form-group">
								<label>Project Scope</label>
								<textarea name="message" rows="4" required placeholder="Describe your web build or media requirements..."></textarea>
							</div>
							<button type="submit" class="btn-apple" style="width: 100%; padding: 14px; font-size: 0.95rem; border: none; cursor: pointer;">
								Send Inquiry
							</button>
						</form>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer>
			<div class="container">
				<p style="margin: 0 0 8px 0;">&copy; 2026 Viewport Digital LLC. All rights reserved[span_1](start_span)[span_1](end_span).</p>
				<p style="font-family: ui-monospace, monospace; font-size: 0.75rem; color: #555558;">kiimon@viewportdigitalmedia.com</p>
			</div>
		</footer>

	</body>
</html>
