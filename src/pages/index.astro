---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Viewport Digital LLC | Code, Capture, Convert">
  <!-- Navigation Header -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-slate-950/90 backdrop-blur-xl border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
      <a href="#" class="flex items-center gap-4 group">
        <!-- Logo container styled as a crisp white app badge to match your logo's background -->
        <div class="bg-white p-2.5 rounded-2xl shadow-xl shadow-cyan-500/10 group-hover:scale-105 transition duration-300">
          <img src="/logo.png" alt="Viewport Digital LLC" class="h-10 md:h-12 w-auto object-contain" />
        </div>
        <div class="hidden sm:flex flex-col">
          <span class="font-extrabold tracking-tight text-white text-lg">VIEWPORT <span class="text-cyan-400">DIGITAL</span></span>
          <span class="text-[10px] uppercase font-mono tracking-widest text-slate-400">Code • Capture • Convert</span>
        </div>
      </a>
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
        <a href="#work" class="hover:text-cyan-400 transition">Portfolio</a>
        <a href="#services" class="hover:text-cyan-400 transition">Capabilities</a>
        <a href="#contact" class="bg-cyan-500 text-slate-950 px-5 py-2.5 rounded-xl hover:bg-cyan-400 transition font-semibold shadow-lg shadow-cyan-500/20">Secure Your Slot</a>
      </nav>
    </div>
  </header>

  <main class="min-h-screen pt-28 relative overflow-hidden bg-slate-950">
    <!-- Ambient Glow Background -->
    <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-cyan-500/15 blur-[150px] rounded-full pointer-events-none"></div>

    <!-- Hero Section -->
    <section class="py-28 px-6 max-w-5xl mx-auto text-center relative z-10">
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-slate-900 border border-slate-800 text-xs font-mono text-cyan-400 mb-8 shadow-inner">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
        Active Build Queue: Q3/Q4 Open
      </div>
      <h1 class="text-6xl md:text-8xl font-black tracking-tighter mb-8 text-white uppercase leading-none">
        Code. Capture. <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-white">Convert.</span>
      </h1>
      <p class="text-xl md:text-2xl text-slate-400 max-w-3xl mx-auto mb-12 leading-relaxed font-light">
        Blazing-fast Astro Jamstack architecture and razor-sharp commercial visual media engineered for businesses that refuse to blend in.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-5">
        <a href="#contact" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-9 py-4 rounded-xl transition shadow-xl shadow-cyan-500/25 text-lg">Initialize Project</a>
        <a href="#work" class="border border-slate-700 hover:border-slate-500 bg-slate-900/40 text-slate-200 px-9 py-4 rounded-xl transition text-lg font-medium">View Capability Proof</a>
      </div>
    </section>

    <!-- Visual Portfolio / Proof Section -->
    <section id="work" class="py-24 px-6 max-w-7xl mx-auto border-t border-slate-900 relative z-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
        <div>
          <span class="text-xs tracking-widest uppercase text-cyan-400 font-mono mb-3 block">Execution Showcase</span>
          <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white">Built for Impact</h2>
        </div>
        <p class="text-slate-400 max-w-md mt-4 md:mt-0">Every asset optimized for sub-second load speeds and pristine visual fidelity.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="group relative rounded-3xl overflow-hidden border border-slate-800 bg-slate-900 h-80">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-cyan-900/40 via-slate-950 to-slate-950 flex items-center justify-center p-6 text-center">
            <span class="text-cyan-400 font-mono text-sm tracking-wider uppercase">Architecture / Jamstack</span>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 z-20">
            <h3 class="text-xl font-bold text-white mb-1">High-Speed Web Platforms</h3>
            <p class="text-sm text-slate-400">Zero bloat, perfect Core Web Vitals.</p>
          </div>
        </div>

        <div class="group relative rounded-3xl overflow-hidden border border-slate-800 bg-slate-900 h-80">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/40 via-slate-950 to-slate-950 flex items-center justify-center p-6 text-center">
            <span class="text-cyan-400 font-mono text-sm tracking-wider uppercase">Commercial Optics</span>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 z-20">
            <h3 class="text-xl font-bold text-white mb-1">Product & Brand Media</h3>
            <p class="text-sm text-slate-400">Sharp, intentional visual storytelling.</p>
          </div>
        </div>

        <div class="group relative rounded-3xl overflow-hidden border border-slate-800 bg-slate-900 h-80">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-sky-900/40 via-slate-950 to-slate-950 flex items-center justify-center p-6 text-center">
            <span class="text-cyan-400 font-mono text-sm tracking-wider uppercase">Conversion Engineering</span>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 z-20">
            <h3 class="text-xl font-bold text-white mb-1">Local Business Authority</h3>
            <p class="text-sm text-slate-400">Turning casual scrollers into clients.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <section id="services" class="py-24 px-6 max-w-7xl mx-auto border-t border-slate-900 relative z-10">
      <div class="text-center mb-16">
        <span class="text-xs tracking-widest uppercase text-cyan-400 font-mono mb-3 block">Dual-Service Agency</span>
        <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white">Core Capabilities</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-10 rounded-3xl hover:border-cyan-500/60 transition group shadow-2xl">
          <div class="w-16 h-16 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-2xl mb-8 group-hover:scale-110 transition shadow-inner">
            ⚡
          </div>
          <h3 class="text-2xl font-bold mb-4 text-white">High-Performance Web Dev</h3>
          <p class="text-slate-400 text-lg leading-relaxed">
            Astro and Jamstack infrastructure built for instantaneous mobile loading speeds, pristine Core Web Vitals, and zero bloated JavaScript drag.
          </p>
        </div>
        <div class="bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-10 rounded-3xl hover:border-cyan-500/60 transition group shadow-2xl">
          <div class="w-16 h-16 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-2xl mb-8 group-hover:scale-110 transition shadow-inner">
            📷
          </div>
          <h3 class="text-2xl font-bold mb-4 text-white">Commercial Photography</h3>
          <p class="text-slate-400 text-lg leading-relaxed">
            Sharp, high-impact visual media captured on professional Canon hardware tailored for real estate, product branding, and local authority.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section id="contact" class="py-32 px-6 max-w-3xl mx-auto border-t border-slate-900 relative z-10">
      <div class="text-center mb-14">
        <h2 class="text-4xl font-extrabold mb-4 text-white tracking-tight">Initiate Contact</h2>
        <p class="text-slate-400 text-lg">Direct pipeline to the agency build queue. Response time under 24 hours.</p>
      </div>
      
      <form action="https://formspree.io/f/xyeyllbk" method="POST" class="space-y-6 bg-slate-900/40 border border-slate-800/90 p-10 rounded-3xl backdrop-blur-xl shadow-2xl">
        <div>
          <label class="block text-sm font-semibold mb-2.5 text-slate-300" for="name">Your Name</label>
          <input type="text" id="name" name="name" required class="w-full bg-slate-950 border border-slate-800 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white placeholder-slate-600" placeholder="John Doe" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-2.5 text-slate-300" for="email">Email Address</label>
          <input type="email" id="email" name="_replyto" required class="w-full bg-slate-950 border border-slate-800 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white placeholder-slate-600" placeholder="john@company.com" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-2.5 text-slate-300" for="message">Project Scope & Requirements</label>
          <textarea id="message" name="message" rows="5" required class="w-full bg-slate-950 border border-slate-800 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white resize-none placeholder-slate-600" placeholder="Outline your web architecture or photography needs..."></textarea>
        </div>
        <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold py-4 rounded-2xl transition shadow-xl shadow-cyan-500/20 text-lg">Transmit Request</button>
      </form>
    </section>
  </main>
</Layout>
