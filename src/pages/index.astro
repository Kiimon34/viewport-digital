---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Viewport Digital LLC | Code, Capture, Convert">
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="py-24 px-6 max-w-5xl mx-auto text-center">
      <span class="text-xs tracking-widest uppercase text-cyan-400 font-mono mb-4 block">Viewport Digital LLC</span>
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6">
        Code, Capture, Convert.
      </h1>
      <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-10">
        High-performance web architecture and commercial-grade visual media built for businesses that refuse to blend in.
      </p>
      <div class="flex justify-center gap-4">
        <a href="#contact" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold px-6 py-3 rounded-lg transition">Start a Project</a>
        <a href="#services" class="border border-slate-800 hover:border-slate-700 px-6 py-3 rounded-lg transition">Explore Services</a>
      </div>
    </section>

    <!-- Services Grid -->
    <section id="services" class="py-20 px-6 max-w-6xl mx-auto border-t border-slate-900">
      <h2 class="text-3xl font-bold mb-12 text-center">Core Capabilities</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-slate-900/50 p-8 rounded-xl border border-slate-800">
          <h3 class="text-xl font-bold mb-3 text-cyan-400">High-Performance Web Dev</h3>
          <p class="text-slate-400">
            Astro-powered Jamstack sites built for lightning-fast mobile loads, pristine Core Web Vitals, and zero unnecessary script bloat.
          </p>
        </div>
        <div class="bg-slate-900/50 p-8 rounded-xl border border-slate-800">
          <h3 class="text-xl font-bold mb-3 text-cyan-400">Commercial Photography</h3>
          <p class="text-slate-400">
            Sharp, intentional imagery tailored for local businesses, real estate, and product branding that turns casual scrollers into paying clients.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section id="contact" class="py-20 px-6 max-w-3xl mx-auto border-t border-slate-900">
      <h2 class="text-3xl font-bold mb-4 text-center">Let's Build</h2>
      <p class="text-slate-400 text-center mb-10">Drop your project details below. Direct line to the build queue.</p>

      <form action="https://formspree.io/f/xyeyllbk" method="POST" class="space-y-6">
        <div>
          <label class="block text-sm font-medium mb-2" for="name">Name</label>
          <input type="text" id="name" name="name" required class="w-full bg-slate-900 border border-slate-800 rounded-lg p-3 focus:border-cyan-500 outline-none transition" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2" for="email">Email</label>
          <input type="email" id="email" name="_replyto" required class="w-full bg-slate-900 border border-slate-800 rounded-lg p-3 focus:border-cyan-500 outline-none transition" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2" for="message">Project Scope</label>
          <textarea id="message" name="message" rows="4" required class="w-full bg-slate-900 border border-slate-800 rounded-lg p-3 focus:border-cyan-500 outline-none transition"></textarea>
        </div>
        <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 rounded-lg transition">Send Message</button>
      </form>
    </section>
  </main>
</Layout>

