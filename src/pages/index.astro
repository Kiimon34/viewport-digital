---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Viewport Digital LLC | Code, Capture, Convert">
  <!-- Navigation Header -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-900">
    <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="#" class="flex items-center gap-3 group">
        <img src="/logo.png" alt="Viewport Digital LLC Logo" class="h-10 w-auto object-contain" />
      </a>
      <nav class="hidden md:flex items-center gap-8 text-sm text-slate-400">
        <a href="#services" class="hover:text-cyan-400 transition">Services</a>
        <a href="#contact" class="bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 px-4 py-2 rounded-lg hover:bg-cyan-500 hover:text-slate-950 transition font-medium">Get in Touch</a>
      </nav>
    </div>
  </header>

  <main class="min-h-screen pt-20 relative overflow-hidden">
    <!-- Ambient Glow Background -->
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-cyan-500/10 blur-[120px] rounded-full pointer-events-none"></div>

    <!-- Hero Section -->
    <section class="py-24 px-6 max-w-5xl mx-auto text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs font-mono text-cyan-400 mb-6">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        Accepting Build Queue Projects
      </div>
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6">
        Code, <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-slate-400">Capture,</span> Convert.
      </h1>
      <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        High-performance web architecture and commercial-grade visual media built for businesses that refuse to blend in.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="#contact" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold px-8 py-4 rounded-xl transition shadow-lg shadow-cyan-500/20">Start a Project</a>
        <a href="#services" class="border border-slate-800 hover:border-slate-700 bg-slate-900/50 px-8 py-4 rounded-xl transition">Explore Capabilities</a>
      </div>
    </section>

    <!-- Services Grid -->
    <section id="services" class="py-24 px-6 max-w-6xl mx-auto border-t border-slate-900 relative z-10">
      <h2 class="text-2xl font-bold mb-12 tracking-tight text-center">Core Capabilities</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-slate-900/40 backdrop-blur border border-slate-800/80 p-8 rounded-2xl hover:border-cyan-500/50 transition group">
          <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 mb-6 group-hover:scale-110 transition">
            ⚡
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">High-Performance Web Dev</h3>
          <p class="text-slate-400 leading-relaxed">
            Astro-powered Jamstack sites built for lightning-fast mobile loads, pristine Core Web Vitals, and zero unnecessary script bloat.
          </p>
        </div>
        <div class="bg-slate-900/40 backdrop-blur border border-slate-800/80 p-8 rounded-2xl hover:border-cyan-500/50 transition group">
          <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 mb-6 group-hover:scale-110 transition">
            📸
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">Commercial Photography</h3>
          <p class="text-slate-400 leading-relaxed">
            Sharp, intentional imagery tailored for local businesses, real estate, and product branding that turns casual scrollers into paying clients.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section id="contact" class="py-24 px-6 max-w-3xl mx-auto border-t border-slate-900 relative z-10">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-3">Let's Build</h2>
        <p class="text-slate-400">Drop your project details below. Direct line to service queue.</p>
      </div>
      
      <form action="https://formspree.io/f/xyeyllbk" method="POST" class="space-y-6 bg-slate-900/30 border border-slate-800 p-8 rounded-2xl backdrop-blur">
        <div>
          <label class="block text-sm font-medium mb-2 text-slate-300" for="name">Name</label>
          <input type="text" id="name" name="name" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-4 focus:border-cyan-500 outline-none transition text-white" placeholder="Jane Doe" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2 text-slate-300" for="email">Email</label>
          <input type="email" id="email" name="_replyto" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-4 focus:border-cyan-500 outline-none transition text-white" placeholder="jane@company.com" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2 text-slate-300" for="message">Project Scope</label>
          <textarea id="message" name="message" rows="4" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-4 focus:border-cyan-500 outline-none transition text-white resize-none" placeholder="Tell us about your web stack or shoot requirements..."></textarea>
        </div>
        <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-4 rounded-xl transition shadow-lg shadow-cyan-500/20">Send Message</button>
      </form>
    </section>
  </main>
</Layout>
