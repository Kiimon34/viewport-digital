---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Viewport Digital LLC | Code, Capture, Convert">
  <header class="fixed top-0 left-0 right-0 z-50 bg-slate-950/90 backdrop-blur-xl border-b border-white/10">
    <div class="max-w-7xl mx-auto px-8 h-28 flex items-center justify-between">
      <a href="/" class="flex items-center gap-5 group">
        <div class="bg-white p-3.5 rounded-2xl shadow-2xl">
          <img src="/logo.png" alt="Viewport Digital LLC" class="h-14 md:h-16 w-auto object-contain" />
        </div>
        <div class="flex flex-col">
          <span class="font-black tracking-tight text-white text-xl">VIEWPORT DIGITAL</span>
          <span class="text-xs uppercase font-mono tracking-widest text-cyan-400">Code • Capture • Convert</span>
        </div>
      </a>
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
        <a href="/" class="text-cyan-400 font-semibold">Web & Commercial</a>
        <a href="/photography" class="hover:text-cyan-400 transition">Portraits & Weddings</a>
        <a href="#contact" class="bg-cyan-500 text-slate-950 px-6 py-3 rounded-xl hover:bg-cyan-400 transition font-bold">Secure Slot</a>
      </nav>
    </div>
  </header>

  <main class="bg-slate-950 text-slate-100 min-h-screen pt-36">
    <section class="py-24 px-8 max-w-6xl mx-auto text-center relative">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-cyan-500/30 bg-cyan-500/10 text-xs font-mono text-cyan-400 mb-8">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        Central Indiana Digital Agency & Commercial Studio
      </div>
      <h1 class="text-6xl sm:text-7xl lg:text-9xl font-black tracking-tighter uppercase mb-8 leading-none">
        Code. Capture. <br /><span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-white">Convert.</span>
      </h1>
      <p class="text-xl text-slate-400 max-w-3xl mx-auto mb-12 font-light leading-relaxed">
        High-performance Astro web architecture and razor-sharp commercial visual media engineered for local businesses that refuse to blend in. Looking for family sessions or weddings? <a href="/photography" class="text-cyan-400 underline underline-offset-4">Switch to our portrait studio gallery.</a>
      </p>
    </section>

    <section id="pricing" class="py-32 px-8 max-w-7xl mx-auto border-t border-white/10">
      <div class="text-center mb-20">
        <span class="text-xs tracking-widest uppercase text-cyan-400 font-mono mb-3 block">Transparent Investment</span>
        <h2 class="text-4xl md:text-6xl font-black tracking-tight text-white uppercase">Web Development Tiers</h2>
      </div>

      <div class="grid lg:grid-cols-3 gap-8 items-stretch">
        <div class="bg-slate-900/40 border border-white/10 p-10 rounded-3xl flex flex-col justify-between backdrop-blur-xl">
          <div>
            <div class="text-cyan-400 font-mono text-xs uppercase tracking-widest mb-3">Tier 1</div>
            <h3 class="text-2xl font-bold text-white mb-2">The Local Landing Page</h3>
            <p class="text-slate-400 text-sm mb-6 font-light">Single-page sites, local service providers, transport companies, or quick campaign launches.</p>
            <div class="text-4xl font-black text-white mb-8">$750 – $1,200 <span class="text-xs font-normal text-slate-400 uppercase font-mono">Flat</span></div>
            <ul class="space-y-4 text-sm text-slate-300 font-light mb-8">
              <li>✓ Single page on Astro</li>
              <li>✓ Mobile-optimized responsive design</li>
              <li>✓ Formspree contact integration</li>
              <li>✓ Vercel edge hosting setup</li>
            </ul>
          </div>
          <a href="#contact" class="w-full bg-slate-800 hover:bg-cyan-500 hover:text-slate-950 text-white font-semibold py-4 rounded-xl transition text-center">Select Tier 1</a>
        </div>

        <div class="bg-slate-900/80 border-2 border-cyan-500/50 p-10 rounded-3xl flex flex-col justify-between backdrop-blur-xl relative shadow-2xl">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-cyan-500 text-slate-950 text-[10px] font-mono font-bold uppercase tracking-widest px-4 py-1 rounded-full">Most Popular</div>
          <div>
            <div class="text-cyan-400 font-mono text-xs uppercase tracking-widest mb-3">Tier 2</div>
            <h3 class="text-2xl font-bold text-white mb-2">Multi-Page Business Core</h3>
            <p class="text-slate-400 text-sm mb-6 font-light">Small local businesses and professional offices needing a robust web footprint.</p>
            <div class="text-4xl font-black text-white mb-8">$1,800 – $3,200 <span class="text-xs font-normal text-slate-400 uppercase font-mono">Flat</span></div>
            <ul class="space-y-4 text-sm text-slate-300 font-light mb-8">
              <li>✓ Up to 5 custom pages</li>
              <li>✓ Integrated commercial photography</li>
              <li>✓ Clean navigation structure</li>
              <li>✓ Top-tier SEO metadata</li>
            </ul>
          </div>
          <a href="#contact" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold py-4 rounded-xl transition text-center">Select Tier 2</a>
        </div>

        <div class="bg-slate-900/40 border border-white/10 p-10 rounded-3xl flex flex-col justify-between backdrop-blur-xl">
          <div>
            <div class="text-cyan-400 font-mono text-xs uppercase tracking-widest mb-3">Tier 3</div>
            <h3 class="text-2xl font-bold text-white mb-2">Custom Portal & App</h3>
            <p class="text-slate-400 text-sm mb-6 font-light">Interactive client onboarding engines, complex multi-step forms, and member workflows.</p>
            <div class="text-4xl font-black text-white mb-8">$3,500 – $6,500+ <span class="text-xs font-normal text-slate-400 uppercase font-mono">Custom</span></div>
            <ul class="space-y-4 text-sm text-slate-300 font-light mb-8">
              <li>✓ Astro SSR configuration</li>
              <li>✓ Supabase database integration</li>
              <li>✓ Secure user authentication</li>
              <li>✓ Custom dashboard components</li>
            </ul>
          </div>
          <a href="#contact" class="w-full bg-slate-800 hover:bg-cyan-500 hover:text-slate-950 text-white font-semibold py-4 rounded-xl transition text-center">Select Tier 3</a>
        </div>
      </div>
    </section>

    <section id="contact" class="py-32 px-8 max-w-3xl mx-auto border-t border-white/10">
      <div class="text-center mb-14">
        <h2 class="text-4xl font-black text-white uppercase tracking-tight mb-3">Initiate Project</h2>
        <p class="text-slate-400 font-light">Direct pipeline to the agency build queue.</p>
      </div>
      
      <form action="https://formspree.io/f/xyeyllbk" method="POST" class="space-y-6 bg-slate-900/40 border border-white/10 p-10 md:p-14 rounded-3xl backdrop-blur-xl">
        <div>
          <label class="block text-xs uppercase font-mono tracking-wider mb-2.5 text-slate-400" for="name">Your Name</label>
          <input type="text" id="name" name="name" required class="w-full bg-slate-950 border border-white/10 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white" />
        </div>
        <div>
          <label class="block text-xs uppercase font-mono tracking-wider mb-2.5 text-slate-400" for="email">Email Address</label>
          <input type="email" id="email" name="_replyto" required class="w-full bg-slate-950 border border-white/10 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white" />
        </div>
        <div>
          <label class="block text-xs uppercase font-mono tracking-wider mb-2.5 text-slate-400" for="message">Project Scope</label>
          <textarea id="message" name="message" rows="5" required class="w-full bg-slate-950 border border-white/10 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white resize-none"></textarea>
        </div>
        <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold py-5 rounded-2xl transition text-lg tracking-wide uppercase">Transmit Request</button>
      </form>
    </section>
  </main>
</Layout>
