<script>
  const form = document.getElementById('lead-form') as HTMLFormElement;
  const statusMsg = document.getElementById('status-msg') as HTMLParagraphElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.innerText = 'Transmitting...';

    const formData = new FormData(form);

    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        body: formData,
      });

      if (res.ok) {
        form.reset();
        statusMsg.textContent = 'Specs transmitted successfully. We will follow up shortly.';
        statusMsg.className = 'text-xs text-[#00E5FF] block';
      } else {
        throw new Error();
      }
    } catch {
      statusMsg.textContent = 'Transmission failure. Please reach out directly.';
      statusMsg.className = 'text-xs text-red-500 block';
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = 'Transmit Specs →';
    }
  });
</script>
