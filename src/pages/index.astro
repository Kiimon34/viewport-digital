---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Viewport Digital LLC | Code, Capture, Convert">
  <!-- Minimalist Floating Header -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-slate-950/70 backdrop-blur-md border-b border-white/5">
    <div class="max-w-7xl mx-auto px-8 h-24 flex items-center justify-between">
      <a href="#" class="flex items-center gap-4 group">
        <div class="bg-white p-2 rounded-xl shadow-2xl">
          <img src="/logo.png" alt="Viewport Digital LLC" class="h-10 w-auto object-contain" />
        </div>
        <span class="font-bold tracking-tight text-white text-lg hidden sm:inline">VIEWPORT DIGITAL</span>
      </a>
      <div class="flex items-center gap-6">
        <a href="#work" class="text-sm text-slate-400 hover:text-white transition">Selected Works</a>
        <a href="#contact" class="bg-white text-slate-950 px-6 py-3 rounded-full text-sm font-semibold hover:bg-cyan-400 transition">Start Project</a>
      </div>
    </div>
  </header>

  <main class="bg-slate-950 text-slate-100 min-h-screen pt-32">
    <!-- Editorial Split Hero -->
    <section class="min-h-[80vh] px-8 max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 items-center py-16">
      <div class="lg:col-span-7 space-y-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 text-xs font-mono text-cyan-400">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
          Indianapolis & Central Indiana Studio
        </div>
        <h1 class="text-6xl sm:text-7xl lg:text-8xl font-black tracking-tighter uppercase leading-[0.9]">
          Engineering <br /><span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-200 to-white">Digital Authority.</span>
        </h1>
        <p class="text-lg text-slate-400 max-w-xl font-light leading-relaxed">
          We merge lightning-fast Astro web architecture with precision commercial photography. Built for brands that demand absolute market dominance.
        </p>
        <div class="flex items-center gap-4 pt-4">
          <a href="#contact" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-8 py-4 rounded-full transition text-base">Secure Your Slot</a>
          <a href="#work" class="border border-white/20 hover:border-white text-white px-8 py-4 rounded-full transition text-base font-medium">Explore Portfolio</a>
        </div>
      </div>
      
      <!-- Editorial Framing Box -->
      <div class="lg:col-span-5 relative">
        <div class="aspect-[4/5] rounded-3xl bg-gradient-to-br from-slate-900 to-slate-900/50 border border-white/10 p-8 flex flex-col justify-between relative overflow-hidden group shadow-2xl">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,_var(--tw-gradient-stops))] from-cyan-500/10 via-transparent to-transparent pointer-events-none"></div>
          <div class="flex justify-between items-start z-10">
            <span class="font-mono text-xs text-slate-500 tracking-widest uppercase">Dual-Discipline Agency</span>
            <span class="text-cyan-400 font-mono text-xs">EST. 2026</span>
          </div>
          <div class="space-y-3 z-10">
            <p class="font-mono text-xs text-cyan-400 tracking-wider uppercase">Current Focus</p>
            <p class="text-2xl font-bold tracking-tight text-white">High-Performance Jamstack & Commercial Media Production</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Immersive Asymmetric Portfolio Showcase -->
    <section id="work" class="py-32 px-8 max-w-7xl mx-auto border-t border-white/10">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
        <div>
          <span class="text-xs tracking-widest uppercase text-cyan-400 font-mono mb-3 block">Selected Case Studies</span>
          <h2 class="text-4xl md:text-6xl font-black tracking-tight text-white">Execution Proof</h2>
        </div>
        <p class="text-slate-400 max-w-sm mt-4 md:mt-0 font-light">Engineered for sub-second load parameters and elite visual conversion.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="group relative rounded-3xl overflow-hidden border border-white/10 bg-slate-900 h-[480px] flex flex-col justify-end p-10">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-cyan-950/50 via-slate-950 to-slate-950"></div>
          <div class="relative z-20 space-y-4">
            <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-mono text-xs uppercase">Tier 2 Multi-Page Core</span>
            <h3 class="text-3xl font-bold text-white tracking-tight">Commercial Architecture & Brand Hubs</h3>
            <p class="text-slate-400 font-light">Full integration of custom photography assets directly into high-performance Astro components.</p>
          </div>
        </div>

        <div class="group relative rounded-3xl overflow-hidden border border-white/10 bg-slate-900 h-[480px] flex flex-col justify-end p-10">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-blue-950/50 via-slate-950 to-slate-950"></div>
          <div class="relative z-20 space-y-4">
            <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-mono text-xs uppercase">Tier 3 Full-Stack Portal</span>
            <h3 class="text-3xl font-bold text-white tracking-tight">Interactive Client Onboarding Engines</h3>
            <p class="text-slate-400 font-light">Secure user authentication and dynamic database pipelines backed by Supabase and Astro SSR.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-32 px-8 max-w-4xl mx-auto border-t border-white/10">
      <div class="text-center mb-16 space-y-4">
        <h2 class="text-4xl md:text-5xl font-black text-white tracking-tight uppercase">Let's Build Your Asset</h2>
        <p class="text-slate-400 text-lg font-light">Submit project parameters directly to the agency build queue.</p>
      </div>
      
      <form action="https://formspree.io/f/xyeyllbk" method="POST" class="space-y-6 bg-slate-900/40 border border-white/10 p-10 md:p-14 rounded-3xl backdrop-blur-xl">
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs uppercase font-mono tracking-wider mb-2.5 text-slate-400" for="name">Your Name</label>
            <input type="text" id="name" name="name" required class="w-full bg-slate-950 border border-white/10 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white" placeholder="Jane Doe" />
          </div>
          <div>
            <label class="block text-xs uppercase font-mono tracking-wider mb-2.5 text-slate-400" for="email">Email Address</label>
            <input type="email" id="email" name="_replyto" required class="w-full bg-slate-950 border border-white/10 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white" placeholder="jane@company.com" />
          </div>
        </div>
        <div>
          <label class="block text-xs uppercase font-mono tracking-wider mb-2.5 text-slate-400" for="message">Project Scope & Tier Selection</label>
          <textarea id="message" name="message" rows="5" required class="w-full bg-slate-950 border border-white/10 rounded-2xl p-4 focus:border-cyan-500 outline-none transition text-white resize-none" placeholder="Specify web architecture requirements or commercial photography needs..."></textarea>
        </div>
        <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold py-5 rounded-2xl transition text-lg tracking-wide uppercase">Initialize Transmission</button>
      </form>
    </section>
  </main>
</Layout>
