---
// Viewport Digital LLC - Agency Landing Page (Full Pricing, Suites & Architecture)
// Stack: Astro, Tailwind CSS, Vercel
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Viewport Digital LLC | High-Performance Web Infrastructure & Media</title>
		<style>
			:root {
				color-scheme: dark;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				background-color: #020617;
				color: #f8fafc;
				line-height: 1.5;
				-webkit-font-smoothing: antialiased;
			}
			header {
				position: sticky;
				top: 0;
				z-index: 50;
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				background-color: rgba(2, 6, 23, 0.85);
				border-bottom: 1px solid rgba(30, 41, 59, 0.8);
			}
			.container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 24px;
			}
			.header-content {
				display: flex;
				align-items: center;
				justify-content: space-between;
				height: 80px;
			}
			.logo {
				font-weight: 800;
				letter-spacing: -0.03em;
				font-size: 1.125rem;
				text-transform: uppercase;
				color: #fff;
				text-decoration: none;
			}
			.logo span {
				color: #94a3b8;
				font-weight: 400;
			}
			nav {
				display: none;
				gap: 32px;
				font-size: 0.875rem;
				font-weight: 500;
				color: #cbd5e1;
			}
			@media(min-width: 768px) {
				nav { display: flex; }
			}
			nav a {
				color: #cbd5e1;
				text-decoration: none;
				transition: color 0.2s;
			}
			nav a:hover { color: #fff; }
			
			.btn-primary {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 12px 24px;
				border-radius: 8px;
				background-color: #fff;
				color: #020617;
				font-weight: 700;
				font-size: 0.875rem;
				letter-spacing: -0.01em;
				text-decoration: none;
				transition: background-color 0.2s;
				box-shadow: 0 4px 12px rgba(255,255,255,0.1);
			}
			.btn-primary:hover { background-color: #e2e8f0; }

			/* Hero Section */
			.hero {
				position: relative;
				overflow: hidden;
				padding: 96px 0 128px 0;
				text-align: center;
			}
			.hero-glow {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 600px;
				height: 600px;
				background: rgba(99, 102, 241, 0.12);
				filter: blur(120px);
				border-radius: 50%;
				pointer-events: none;
			}
			.badge {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 6px 16px;
				border-radius: 9999px;
				background-color: #0f172a;
				border: 1px solid #1e293b;
				font-size: 0.75rem;
				color: #cbd5e1;
				margin-bottom: 32px;
				font-family: ui-monospace, monospace;
			}
			.dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background-color: #10b981;
			}
			h1 {
				font-size: 3rem;
				font-weight: 800;
				letter-spacing: -0.03em;
				line-height: 1.05;
				color: #fff;
				margin: 0 0 24px 0;
			}
			@media(min-width: 640px) {
				h1 { font-size: 4.5rem; }
			}
			.hero-p {
				max-width: 650px;
				margin: 0 auto 40px auto;
				font-size: 1.125rem;
				color: rgba(203, 213, 225, 0.9);
				line-height: 1.6;
			}
			.hero-actions {
				display: flex;
				flex-direction: column;
				gap: 16px;
				justify-content: center;
				align-items: center;
			}
			@media(min-width: 640px) {
				.hero-actions { flex-direction: row; }
			}
			.btn-secondary {
				padding: 16px 32px;
				border-radius: 12px;
				background-color: #0f172a;
				border: 1px solid #1e293b;
				color: #fff;
				font-weight: 600;
				text-decoration: none;
				transition: background-color 0.2s;
			}
			.btn-secondary:hover { background-color: #1e293b; }

			/* Section Styling */
			section {
				padding: 96px 0;
				border-top: 1px solid rgba(30, 41, 59, 0.5);
			}
			.section-header {
				max-width: 700px;
				margin-bottom: 64px;
			}
			.section-header h2 {
				font-size: 2.25rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: #fff;
				margin: 0 0 16px 0;
			}
			.section-header p {
				color: #94a3b8;
				font-size: 1rem;
				line-height: 1.6;
			}
			.grid-3 {
				display: grid;
				grid-template-columns: 1fr;
				gap: 32px;
			}
			@media(min-width: 768px) {
				.grid-3 { grid-template-columns: repeat(3, 1fr); }
			}
			.grid-2 {
				display: grid;
				grid-template-columns: 1fr;
				gap: 32px;
			}
			@media(min-width: 768px) {
				.grid-2 { grid-template-columns: repeat(2, 1fr); }
			}

			/* Cards */
			.card {
				padding: 32px;
				border-radius: 16px;
				background-color: rgba(15, 23, 42, 0.6);
				border: 1px solid rgba(30, 41, 59, 0.8);
				backdrop-filter: blur(12px);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				transition: border-color 0.2s;
			}
			.card:hover { border-color: #475569; }
			.card-price {
				font-size: 1.75rem;
				font-weight: 800;
				color: #fff;
				margin: 16px 0 8px 0;
				letter-spacing: -0.02em;
			}
			.card h3 {
				font-size: 1.25rem;
				font-weight: 700;
				color: #fff;
				margin: 0 0 8px 0;
			}
			.card p {
				color: #94a3b8;
				font-size: 0.875rem;
				line-height: 1.6;
				margin: 0 0 24px 0;
			}
			.card-tag {
				font-size: 0.75rem;
				font-family: ui-monospace, monospace;
				color: #818cf8;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.features-list {
				list-style: none;
				padding: 0;
				margin: 0 0 24px 0;
				font-size: 0.875rem;
				color: #cbd5e1;
			}
			.features-list li {
				padding: 6px 0;
				border-bottom: 1px solid rgba(30, 41, 59, 0.4);
			}

			/* Comparison Section */
			.comparison-box {
				background: linear-gradient(180deg, rgba(15,23,42,0.8) 0%, rgba(2,6,23,0.9) 100%);
				border: 1px solid #1e293b;
				border-radius: 20px;
				padding: 48px;
			}

			/* Contact Form */
			.contact-box {
				max-width: 700px;
				margin: 0 auto;
				text-align: center;
			}
			.form-wrap {
				padding: 40px;
				border-radius: 20px;
				background-color: rgba(15, 23, 42, 0.4);
				border: 1px solid #1e293b;
				text-align: left;
			}
			.form-group {
				margin-bottom: 24px;
			}
			label {
				display: block;
				font-size: 0.75rem;
				font-family: ui-monospace, monospace;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: #94a3b8;
				margin-bottom: 8px;
			}
			input, textarea {
				width: 100%;
				padding: 14px 16px;
				border-radius: 8px;
				background-color: #020617;
				border: 1px solid #1e293b;
				color: #fff;
				font-size: 0.875rem;
				box-sizing: border-box;
				outline: none;
				transition: border-color 0.2s;
			}
			input:focus, textarea:focus { border-color: #64748b; }
			
			footer {
				border-top: 1px solid #0f172a;
				padding: 48px 0;
			}
			.footer-content {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: space-between;
				gap: 16px;
				font-size: 0.875rem;
				color: #64748b;
			}
			@media(min-width: 640px) {
				.footer-content { flex-direction: row; }
			}
		</style>
	</head>
	<body>

		<!-- Header -->
		<header>
			<div class="container header-content">
				<a href="/" class="logo">Viewport Digital <span>LLC</span></a>
				<nav>
					<a href="#web-tiers">Web Tiers</a>
					<a href="#retainers">Retainers</a>
					<a href="#media">Media</a>
					<a href="#advantage">Why Us</a>
				</nav>
				<div>
					<a href="#contact" class="btn-primary">Inquire Now</a>
				</div>
			</div>
		</header>

		<main>
			<!-- Hero Section -->
			<section class="hero">
				<div class="hero-glow"></div>
				<div class="container" style="position: relative; z-index: 10;">
					<div class="badge">
						<span class="dot"></span>
						Based in Carmel, Indiana
					</div>

					<h1>Code. Capture. Convert.</h1>

					<p class="hero-p">
						We build high-performance web infrastructure and commercial media for brands that refuse to blend in. Zero database bloat. Pure speed.
					</p>

					<div class="hero-actions">
						<a href="#contact" class="btn-primary" style="padding: 16px 32px; border-radius: 12px; font-size: 1rem;">
							Start Your Build
						</a>
						<a href="#web-tiers" class="btn-secondary">
							Explore Pricing
						</a>
					</div>
				</div>
			</section>

			<!-- Web Development Tiers -->
			<section id="web-tiers">
				<div class="container">
					<div class="section-header">
						<h2>Web Development Tiers.</h2>
						<p>Engineered via Astro and Vercel for instantaneous load times, rigid security, and zero legacy bloat.</p>
					</div>

					<div class="grid-3">
						<!-- Tier 1 -->
						<div class="card">
							<div>
								<span class="card-tag">Tier 1</span>
								<h3>The Local Landing Page</h3>
								<div class="card-price">$750 – $1,200</div>
								<p>Best for single-page sites, local service providers, transport companies, or quick campaign launches.</p>
								<ul class="features-list">
									<li>High-impact single page on Astro</li>
									<li>Mobile-optimized responsive design</li>
									<li>Formspree contact form integration</li>
									<li>Lightning-fast Vercel edge hosting</li>
								</ul>
							</div>
							<a href="#contact" class="btn-secondary" style="text-align: center; display: block; padding: 12px;">Select Tier 1</a>
						</div>

						<!-- Tier 2 -->
						<div class="card" style="border-color: #6366f1;">
							<div>
								<span class="card-tag" style="color: #a5b4fc;">Tier 2 (Most Popular)</span>
								<h3>Multi-Page Business Core</h3>
								<div class="card-price">$1,800 – $3,200</div>
								<p>Best for small local businesses, professional offices, or trade contractors needing a robust web footprint.</p>
								<ul class="features-list">
									<li>Up to 5 custom pages (Home, Services, About, Gallery, Contact)</li>
									<li>Integrated commercial photography assets</li>
									<li>Clean navigation structure</li>
									<li>Top-tier SEO metadata & performance</li>
								</ul>
							</div>
							<a href="#contact" class="btn-primary" style="text-align: center; display: block; padding: 12px;">Select Tier 2</a>
						</div>

						<!-- Tier 3 -->
						<div class="card">
							<div>
								<span class="card-tag">Tier 3</span>
								<h3>Custom Portal & App</h3>
								<div class="card-price">$3,500 – $6,500+</div>
								<p>Best for interactive client onboarding engines, complex multi-step questionnaires, and member workflows.</p>
								<ul class="features-list">
									<li>Astro Server-Side Rendering (SSR)</li>
									<li>Database integration (Supabase)</li>
									<li>Secure user authentication</li>
									<li>Custom dashboard components</li>
								</ul>
							</div>
							<a href="#contact" class="btn-secondary" style="text-align: center; display: block; padding: 12px;">Select Tier 3</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Monthly Retainers -->
			<section id="retainers" style="background-color: rgba(15, 23, 42, 0.3);">
				<div class="container">
					<div class="section-header">
						<h2>Monthly Maintenance Retainers.</h2>
						<p>Protect your digital investment with ongoing oversight, monitoring, and proactive updates.</p>
					</div>

					<div class="grid-3">
						<div class="card">
							<div>
								<h3>Basic Care</h3>
								<div class="card-price">$75 <span style="font-size: 1rem; color: #94a3b8; font-weight: 400;">/mo</span></div>
								<p>Covers monthly framework checks, Vercel deployment upkeep, uptime monitoring, and up to 30 minutes of minor text updates.</p>
							</div>
							<span class="card-tag">Standard Upkeep</span>
						</div>

						<div class="card">
							<div>
								<h3>Growth Retainer</h3>
								<div class="card-price">$150 <span style="font-size: 1rem; color: #94a3b8; font-weight: 400;">/mo</span></div>
								<p>Includes standard monitoring plus priority support and up to two (2) hours of minor content edits or fresh asset swaps per month.</p>
							</div>
							<span class="card-tag">Active Growth</span>
						</div>

						<div class="card">
							<div>
								<h3>Scale Retainer</h3>
								<div class="card-price">$300 <span style="font-size: 1rem; color: #94a3b8; font-weight: 400;">/mo</span></div>
								<p>Built for dynamic portals; covers active database management, priority same-day bug remediation, and up to four (4) hours of updates.</p>
							</div>
							<span class="card-tag">Enterprise Support</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Media & Photography Suites -->
			<section id="media">
				<div class="container">
					<div class="section-header">
						<h2>Commercial & Event Media.</h2>
						<p>High-end visual assets engineered to populate your digital properties and elevate your brand presence.</p>
					</div>

					<div class="grid-3" style="margin-bottom: 48px;">
						<div class="card">
							<div>
								<span class="card-tag">Commercial</span>
								<h3>Web Asset Starter</h3>
								<div class="card-price">$350 flat</div>
								<p>Natural pairing for single-page builds. 1 hour on-site, 10 to 15 fully edited, web-optimized files.</p>
							</div>
							<span style="font-size: 0.8rem; color: #10b981;">Bundle Discount: Save $150 with web dev</span>
						</div>

						<div class="card">
							<div>
								<span class="card-tag">Commercial</span>
								<h3>Full Brand Suite</h3>
								<div class="card-price">$750 flat</div>
								<p>Half-day commitment for multi-page cores. Action shots, crew workflow, interior details, and curb appeal (30–40 files).</p>
							</div>
							<span style="font-size: 0.8rem; color: #10b981;">Bundle Discount: Save $150 with web dev</span>
						</div>

						<div class="card">
							<div>
								<span class="card-tag">Commercial</span>
								<h3>Full-Day Production</h3>
								<div class="card-price">$1,500+</div>
								<p>Heavy lifting. Full day on-site, complex lighting setups, multi-room facilities, inventory catalogs, and deep file delivery.</p>
							</div>
							<span style="font-size: 0.8rem; color: #10b981;">Bundle Discount: Save $150 with web dev</span>
						</div>
					</div>

					<div class="grid-2">
						<div class="card">
							<div>
								<h3>Family & Portrait Sessions</h3>
								<ul class="features-list" style="margin-top: 16px;">
									<li><strong>Essentials Mini-Session ($175):</strong> 30 min at a local backdrop, 10–15 edited files.</li>
									<li><strong>Full Family Story ($325):</strong> Up to 90 mins, multiple outfit swaps, up to 5 members ($25/extra person), 30–40 edited files.</li>
								</ul>
							</div>
						</div>

						<div class="card">
							<div>
								<h3>Events & Weddings</h3>
								<ul class="features-list" style="margin-top: 16px;">
									<li><strong>Hourly Event Coverage ($150/hr):</strong> 2-hour minimum for parties, reunions, and gatherings.</li>
									<li><strong>Intimate & Elopement ($1,200):</strong> Up to 4 hours of coverage for smaller ceremonies.</li>
									<li><strong>Full-Day Wedding ($2,200):</strong> Up to 8 hours of storytelling, timeline planning, and full gallery download.</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Why Us & Code Ownership vs Subscription Traps -->
			<section id="advantage" style="background-color: rgba(15, 23, 42, 0.3);">
				<div class="container">
					<div class="comparison-box">
						<div class="section-header" style="margin-bottom: 32px;">
							<h2>Ownership vs. Subscription Traps.</h2>
							<p>Why custom code beats bloated DIY builders like GoDaddy, Wix, and Replit every single time.</p>
						</div>

						<div class="grid-2" style="gap: 48px;">
							<div>
								<h3 style="color: #ef4444; margin-bottom: 16px;">The DIY Subscription Trap</h3>
								<p style="color: #94a3b8; font-size: 0.9rem; line-height: 1.6;">
									Platforms like GoDaddy and Wix lock you into endless monthly fees for slow, bloated templates that choke on mobile devices, hurt SEO rankings, and look identical to your competitors. When something breaks, you talk to a call center robot.
								</p>
							</div>
							<div>
								<h3 style="color: #10b981; margin-bottom: 16px;">The Viewport Digital Advantage</h3>
								<p style="color: #94a3b8; font-size: 0.9rem; line-height: 1.6;">
									You own your code. Built with Astro and Vercel for raw speed, zero database bloat, and bulletproof reliability. Plus, we bring professional media production directly to your door—combining elite web infrastructure with custom commercial photography in one seamless partnership.
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Contact / Inquiry Section -->
			<section id="contact">
				<div class="container">
					<div class="contact-box">
						<div class="section-header" style="margin: 0 auto 32px auto;">
							<h2>Let's Build Your Digital Footprint.</h2>
							<p>Reach out directly to kick off your web build, schedule a media session, or lock in your retainer.</p>
						</div>

						<div class="form-wrap">
							<form action="https://formspree.io/f/xlgpqvaz" method="POST">
								<div class="form-group">
									<label>Your Name</label>
									<input type="text" name="name" required placeholder="Jane Doe" />
								</div>
								<div class="form-group">
									<label>Email Address</label>
									<input type="email" name="email" required placeholder="jane@company.com" />
								</div>
								<div class="form-group">
									<label>Project Scope & Tier Selection</label>
									<textarea name="message" rows="4" required placeholder="Tell us about your web build, tier selection, or photography needs..."></textarea>
								</div>
								<button type="submit" class="btn-primary" style="width: 100%; border: none; cursor: pointer; padding: 16px; font-size: 1rem;">
									Submit Inquiry
								</button>
							</form>
						</div>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer>
			<div class="container footer-content">
				<p>&copy; 2026 Viewport Digital LLC. All rights reserved[span_0](start_span)[span_0](end_span).</p>
				<p style="font-family: ui-monospace, monospace; font-size: 0.75rem;">kiimon@viewportdigitalmedia.com</p>
			</div>
		</footer>

	</body>
</html>
