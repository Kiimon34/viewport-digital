---
// src/pages/index.astro
// Viewport Digital LLC - Self-Contained Edge Architecture
const pageTitle = "Viewport Digital LLC | Engineered Digital Architecture & Commercial Photography";
const pageDescription = "Bespoke engineering on Astro, edge delivery via Vercel, and custom commercial photography. Zero templates. Zero subscriptions. You own the code.";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />

  <!-- Tailwind Fallback CDN Engine (Guarantees styling renders immediately) -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              black: '#030712',
              surface: '#0B0F19',
              card: 'rgba(15, 23, 42, 0.65)',
              border: 'rgba(255, 255, 255, 0.08)',
              borderHover: 'rgba(56, 189, 248, 0.4)',
              silver: '#CBD5E1',
              silverMuted: '#94A3B8',
              navy: '#0F172A',
              navyDeep: '#020617',
              blue: '#2563EB',
              blueVibrant: '#38BDF8',
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            display: ['"Space Grotesk"', 'sans-serif'],
          }
        }
      }
    }
  </script>
</head>

<body class="bg-[#030712] text-[#CBD5E1] font-sans antialiased selection:bg-[#2563EB] selection:text-white bg-grid-mesh relative overflow-x-hidden min-h-screen">

  <!-- Ambient Light Orbs -->
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-gradient-to-tr from-[#2563EB]/15 to-[#38BDF8]/10 blur-[130px] pointer-events-none -z-10"></div>
  <div class="fixed bottom-0 right-0 w-[600px] h-[500px] bg-gradient-to-tl from-[#0F172A]/60 via-[#2563EB]/10 to-transparent blur-[140px] pointer-events-none -z-10"></div>

  <!-- Persistent Header -->
  <header class="sticky top-0 z-50 w-full px-4 sm:px-8 py-4 backdrop-blur-md bg-[#030712]/75 border-b border-white/[0.08]">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <a href="#hero" class="flex items-center gap-3 group text-decoration-none">
        <div class="w-9 h-9 min-w-[36px] max-w-[36px] h-[36px] rounded-lg bg-gradient-to-br from-[#2563EB] to-[#0F172A] border border-[#38BDF8]/40 flex items-center justify-center shadow-lg shadow-[#2563EB]/20 shrink-0">
          <svg class="w-5 h-5 max-w-[20px] max-h-[20px] text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <div class="flex flex-col text-left">
          <span class="text-base font-bold font-display tracking-tight text-white group-hover:text-[#38BDF8] transition-colors leading-none">VIEWPORT DIGITAL</span>
          <span class="text-[10px] uppercase tracking-widest text-[#94A3B8]/70 font-mono mt-1">Architectural Web</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8 text-xs font-semibold uppercase tracking-wider text-[#94A3B8]">
        <a href="#engineered" class="hover:text-white transition-colors">The Paradigm</a>
        <a href="#stack" class="hover:text-white transition-colors">Stack & Specs</a>
        <a href="#photography" class="hover:text-white transition-colors">Photography</a>
        <a href="#pricing" class="hover:text-white transition-colors">Tiers & Rates</a>
      </nav>

      <!-- Primary Action CTA -->
      <div class="flex items-center gap-3">
        <a href="#pricing" class="tactile-btn relative inline-flex items-center justify-center px-4 sm:px-5 py-2 sm:py-2.5 text-xs font-semibold uppercase tracking-wider text-white bg-[#2563EB] hover:bg-blue-600 rounded-lg shadow-lg shadow-[#2563EB]/30 border border-[#38BDF8]/50 overflow-hidden group">
          <span class="relative z-10 flex items-center gap-2">
            Initiate Project
            <svg class="w-3.5 h-3.5 max-w-[14px] transition-transform group-hover:translate-x-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </header>

  <main class="space-y-20 sm:space-y-32">

    <!-- HERO SECTION -->
    <section id="hero" class="relative pt-12 sm:pt-24 px-4 sm:px-8 max-w-7xl mx-auto">
      <div class="fade-observe flex flex-col items-center text-center max-w-4xl mx-auto space-y-6 sm:space-y-8">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F172A]/80 border border-white/[0.08] text-[11px] font-mono tracking-widest uppercase text-[#94A3B8]">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Bespoke Engineering & Authentic Optics</span>
        </div>

        <h1 class="text-3xl sm:text-6xl md:text-7xl font-display font-bold tracking-[-0.03em] leading-[1.08] text-white">
          Own your digital footprint. <br />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#CBD5E1] via-[#38BDF8] to-[#2563EB]">
            No templates. No monthly rent.
          </span>
        </h1>

        <p class="text-sm sm:text-lg text-[#94A3B8] leading-relaxed max-w-[650px]">
          Most agencies lease you bloated WordPress themes on life support. Viewport Digital writes high-performance static architecture on Astro, paired with bespoke commercial photography that captures real physical substance.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4 pt-2 w-full sm:w-auto">
          <a href="#pricing" class="tactile-btn w-full sm:w-auto px-8 py-4 rounded-xl text-sm font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#2563EB] to-blue-700 hover:from-blue-600 hover:to-blue-800 border border-[#38BDF8]/40 shadow-xl shadow-[#2563EB]/30 text-center">
            View Tiers & Pricing
          </a>
          <a href="#engineered" class="tactile-btn w-full sm:w-auto px-8 py-4 rounded-xl text-sm font-semibold tracking-wider text-[#CBD5E1] hover:text-white glass-panel border border-white/[0.08] hover:border-white/20 text-center">
            Compare The Architecture
          </a>
        </div>

        <!-- Archival Trust Metrics -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full pt-10 text-left">
          <div class="glass-panel p-4 rounded-xl">
            <span class="font-mono text-xs text-[#94A3B8] block">RENDER TIME</span>
            <span class="font-display text-2xl font-bold text-white">&lt; 350ms</span>
            <p class="text-xs text-[#94A3B8] mt-1">Edge distribution via Vercel</p>
          </div>
          <div class="glass-panel p-4 rounded-xl">
            <span class="font-mono text-xs text-[#94A3B8] block">CODE OWNERSHIP</span>
            <span class="font-display text-2xl font-bold text-[#38BDF8]">100%</span>
            <p class="text-xs text-[#94A3B8] mt-1">Stored in your GitHub repo</p>
          </div>
          <div class="glass-panel p-4 rounded-xl">
            <span class="font-mono text-xs text-[#94A3B8] block">MONTHLY RENT</span>
            <span class="font-display text-2xl font-bold text-emerald-400">$0.00</span>
            <p class="text-xs text-[#94A3B8] mt-1">Zero mandatory site fees</p>
          </div>
          <div class="glass-panel p-4 rounded-xl">
            <span class="font-mono text-xs text-[#94A3B8] block">VISUAL ASSETS</span>
            <span class="font-display text-2xl font-bold text-white">Full Raw/Edit</span>
            <p class="text-xs text-[#94A3B8] mt-1">Authentic commercial photography</p>
          </div>
        </div>

      </div>
    </section>

    <!-- ARCHITECTURAL COMPARISON -->
    <section id="engineered" class="px-4 sm:px-8 max-w-7xl mx-auto">
      <div class="fade-observe space-y-4 mb-10 text-center md:text-left">
        <span class="text-xs font-mono tracking-widest text-[#38BDF8] uppercase">Engineering Contrast</span>
        <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">The Reality Gap: Engineered Code vs. Subscription Clutter</h2>
        <p class="text-[#94A3B8] max-w-2xl text-sm sm:text-base">
          Wix, Squarespace, and bloated CMS builds hold your domain hostage while bleeding recurring cash. Here is the concrete technical breakdown.
        </p>
      </div>

      <div class="fade-observe grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="glass-panel p-6 sm:p-8 rounded-2xl relative overflow-hidden flex flex-col justify-between">
          <div class="space-y-4">
            <span class="text-xs font-mono uppercase tracking-wider text-[#38BDF8]">Structural Model</span>
            <h3 class="text-xl sm:text-2xl font-display font-bold text-white">Engineered vs. Template</h3>
            <p class="text-xs sm:text-sm text-[#94A3B8] leading-relaxed">
              Templates load 40 unused JavaScript libraries, tracking bloat, and fragile layout builders that collapse across screens.
            </p>
            <ul class="space-y-2.5 pt-2 text-xs font-mono">
              <li class="flex items-center gap-2 text-white">
                <svg class="w-4 h-4 max-w-[16px] text-[#38BDF8] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Engineered: Semantic Astro HTML compiled at build
              </li>
              <li class="flex items-center gap-2 text-[#94A3B8]">
                <svg class="w-4 h-4 max-w-[16px] text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                Templates: 4MB DOM trees and messy div soup
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-white/[0.08] text-xs text-[#94A3B8]">
            Result: 100/100 Google Lighthouse performance score.
          </div>
        </div>

        <div class="glass-panel p-6 sm:p-8 rounded-2xl relative overflow-hidden flex flex-col justify-between border-[#2563EB]/40">
          <div class="space-y-4">
            <span class="text-xs font-mono uppercase tracking-wider text-[#38BDF8]">Financial Model</span>
            <h3 class="text-xl sm:text-2xl font-display font-bold text-white">Flat Fee vs. Subscription</h3>
            <p class="text-xs sm:text-sm text-[#94A3B8] leading-relaxed">
              Agencies trap you in $200–$500/month recurring builder fees just to keep your landing page live. Stop paying monthly rent for plain text.
            </p>
            <ul class="space-y-2.5 pt-2 text-xs font-mono">
              <li class="flex items-center gap-2 text-white">
                <svg class="w-4 h-4 max-w-[16px] text-[#38BDF8] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Flat Fee: You pay once for the completed asset
              </li>
              <li class="flex items-center gap-2 text-[#94A3B8]">
                <svg class="w-4 h-4 max-w-[16px] text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                Subscription: Monthly lock-ins that compound forever
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-white/[0.08] text-xs text-[#94A3B8]">
            Result: Real capital efficiency and predictable spend.
          </div>
        </div>

        <div class="glass-panel p-6 sm:p-8 rounded-2xl relative overflow-hidden flex flex-col justify-between">
          <div class="space-y-4">
            <span class="text-xs font-mono uppercase tracking-wider text-[#38BDF8]">Asset Control</span>
            <h3 class="text-xl sm:text-2xl font-display font-bold text-white">Ownership vs. Renting</h3>
            <p class="text-xs sm:text-sm text-[#94A3B8] leading-relaxed">
              If your SaaS provider closes or hikes fees 300%, you lose your website. Viewport delivers pure code you can host anywhere on earth.
            </p>
            <ul class="space-y-2.5 pt-2 text-xs font-mono">
              <li class="flex items-center gap-2 text-white">
                <svg class="w-4 h-4 max-w-[16px] text-[#38BDF8] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Ownership: Clean Git repo and DNS ownership
              </li>
              <li class="flex items-center gap-2 text-[#94A3B8]">
                <svg class="w-4 h-4 max-w-[16px] text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                Renting: Proprietary silos you cannot export
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-white/[0.08] text-xs text-[#94A3B8]">
            Result: A true digital asset that adds equity to your balance sheet.
          </div>
        </div>

      </div>
    </section>

    <!-- THE PRODUCTION STACK -->
    <section id="stack" class="px-4 sm:px-8 max-w-7xl mx-auto">
      <div class="fade-observe glass-panel p-6 sm:p-12 rounded-3xl border border-white/[0.08] relative overflow-hidden">
        
        <div class="max-w-3xl space-y-4 mb-10">
          <span class="text-xs font-mono tracking-widest text-[#38BDF8] uppercase">Modern Stack Ecosystem</span>
          <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">Purpose-Built Infrastructure</h2>
          <p class="text-[#94A3B8] text-xs sm:text-base leading-relaxed">
            Every layer of your build is selected for zero bloat, sub-second execution, enterprise-tier security, and clean developer ergonomics.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 font-mono">
          
          <div class="p-5 rounded-xl bg-[#0B0F19]/70 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors">
            <div class="flex items-center justify-between text-[#38BDF8] text-xs mb-2">
              <span class="font-bold">ASTRO</span>
              <span>RENDER CORE</span>
            </div>
            <p class="text-xs text-[#CBD5E1] leading-relaxed font-sans">
              Handles lightning-fast static rendering by stripping away client-side JS by default for raw HTML delivery.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-[#0B0F19]/70 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors">
            <div class="flex items-center justify-between text-[#38BDF8] text-xs mb-2">
              <span class="font-bold">VERCEL</span>
              <span>EDGE COMPUTE</span>
            </div>
            <p class="text-xs text-[#CBD5E1] leading-relaxed font-sans">
              Powers instant global edge deployments, auto-routing your visitors to the nearest data center node.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-[#0B0F19]/70 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors">
            <div class="flex items-center justify-between text-[#38BDF8] text-xs mb-2">
              <span class="font-bold">CURSOR + GEMINI</span>
              <span>SYNTHESIS</span>
            </div>
            <p class="text-xs text-[#CBD5E1] leading-relaxed font-sans">
              Drives clean workspace code generation, eliminating human error across boilerplate and schema definitions.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-[#0B0F19]/70 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors">
            <div class="flex items-center justify-between text-[#38BDF8] text-xs mb-2">
              <span class="font-bold">GITHUB</span>
              <span>VERSION CONTROL</span>
            </div>
            <p class="text-xs text-[#CBD5E1] leading-relaxed font-sans">
              Anchors version control and provides full transparency. You hold the master branch keys forever.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-[#0B0F19]/70 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors">
            <div class="flex items-center justify-between text-[#38BDF8] text-xs mb-2">
              <span class="font-bold">TAILWIND CSS</span>
              <span>DESIGN SYSTEM</span>
            </div>
            <p class="text-xs text-[#CBD5E1] leading-relaxed font-sans">
              Styles the UI through strict atomic token sets without runtime styling engine bottlenecks.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-[#0B0F19]/70 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors">
            <div class="flex items-center justify-between text-[#38BDF8] text-xs mb-2">
              <span class="font-bold">SUPABASE</span>
              <span>RELATIONAL DATA</span>
            </div>
            <p class="text-xs text-[#CBD5E1] leading-relaxed font-sans">
              Handles database scaling, user auth pools, and PostgreSQL storage when dynamic portals are required.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-[#0B0F19]/70 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors">
            <div class="flex items-center justify-between text-[#38BDF8] text-xs mb-2">
              <span class="font-bold">SENTRY</span>
              <span>TELEMETRY</span>
            </div>
            <p class="text-xs text-[#CBD5E1] leading-relaxed font-sans">
              Catches production errors and client performance regressions before customers notice them.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-[#0B0F19]/70 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors">
            <div class="flex items-center justify-between text-[#38BDF8] text-xs mb-2">
              <span class="font-bold">RESEND</span>
              <span>COMMUNICATIONS</span>
            </div>
            <p class="text-xs text-[#CBD5E1] leading-relaxed font-sans">
              Manages transactional lead alerts and customer confirmation emails with 99.9% inbox deliverability.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-[#0B0F19]/70 border border-white/[0.06] hover:border-[#38BDF8]/40 transition-colors">
            <div class="flex items-center justify-between text-[#38BDF8] text-xs mb-2">
              <span class="font-bold">CLOUDFLARE</span>
              <span>SECURITY & DNS</span>
            </div>
            <p class="text-xs text-[#CBD5E1] leading-relaxed font-sans">
              Locks down the DNS edge with enterprise DDoS mitigation and high-speed SSL cert rotation.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- COMMERCIAL PHOTOGRAPHY INTEGRATION -->
    <section id="photography" class="px-4 sm:px-8 max-w-7xl mx-auto">
      <div class="fade-observe grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-mono tracking-widest text-[#38BDF8] uppercase">Authentic Visual Assets</span>
          <h2 class="text-2xl sm:text-5xl font-display font-bold text-white tracking-tight leading-tight">
            Stop pasting fake stock photos into real business websites.
          </h2>
          <p class="text-[#94A3B8] text-xs sm:text-base leading-relaxed">
            Customers immediately spot plastic corporate stock photography. It destroys trust before they finish reading your hero line. Viewport Digital pairs web architecture directly with dedicated commercial photography.
          </p>
          <div class="space-y-3 pt-2">
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 rounded bg-[#0F172A] flex items-center justify-center border border-[#2563EB]/40 text-[#38BDF8] text-xs font-bold shrink-0 mt-0.5">01</div>
              <p class="text-xs sm:text-sm text-[#CBD5E1]"><strong class="text-white">Workspace & Field Reality:</strong> Crisp shots of your team doing the actual work, shop interiors, fleet machinery, and storefront curb appeal.</p>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 rounded bg-[#0F172A] flex items-center justify-center border border-[#2563EB]/40 text-[#38BDF8] text-xs font-bold shrink-0 mt-0.5">02</div>
              <p class="text-xs sm:text-sm text-[#CBD5E1]"><strong class="text-white">Component-Ready Assets:</strong> Formatted specifically for Astro modern image pipelines (AVIF/WebP) with custom aspect ratios that do not break CSS grids.</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 glass-panel p-6 sm:p-8 rounded-2xl border border-white/[0.08] relative">
          <div class="flex items-center justify-between pb-4 border-b border-white/[0.08] text-xs font-mono text-[#94A3B8]">
            <span>OPTICAL_PIPELINE.LOG</span>
            <span class="text-emerald-400">READY FOR ASTRO</span>
          </div>
          <div class="mt-6 space-y-4">
            <div class="h-44 sm:h-56 rounded-xl bg-gradient-to-br from-[#0F172A] via-[#0B0F19] to-[#030712] border border-white/[0.08] flex items-center justify-center relative overflow-hidden group">
              <div class="absolute inset-0 bg-[#2563EB]/10 opacity-30 group-hover:opacity-60 transition-opacity"></div>
              <div class="text-center p-4 relative z-10">
                <svg class="w-12 h-12 max-w-[48px] max-h-[48px] text-[#94A3B8] mx-auto mb-2 opacity-60 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="font-mono text-xs text-[#CBD5E1] uppercase tracking-wider block">Raw Optical Precision</span>
                <span class="text-[11px] text-[#94A3B8]">Sony Full-Frame Prime Captures • Custom Color Profiles</span>
              </div>
            </div>
            
            <div class="p-4 rounded-lg bg-[#0F172A]/60 border border-white/[0.08] flex items-center justify-between">
              <div>
                <span class="text-xs font-bold text-white block">The Web Dev Bundle Incentive</span>
                <span class="text-[11px] text-[#94A3B8]">Save $150 instantly when bundled with any website tier</span>
              </div>
              <span class="text-sm font-mono font-bold text-emerald-400">-$150.00</span>
            </div>
          </div>
        </div>

