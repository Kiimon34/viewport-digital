---
// src/layouts/Layout.astro
interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const { 
  title, 
  description = "Bespoke engineering on Astro, edge distribution via Vercel, and custom commercial photography. Zero templates. Zero subscriptions. You own the code.",
  currentPath = "/"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />

  <!-- Self-Healing Tailwind CDN Engine -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              black: '#030712',
              surface: '#0B0F19',
              card: 'rgba(15, 23, 42, 0.65)',
              border: 'rgba(255, 255, 255, 0.08)',
              silver: '#CBD5E1',
              silverMuted: '#94A3B8',
              navy: '#0F172A',
              navyDeep: '#020617',
              blue: '#2563EB',
              blueVibrant: '#38BDF8',
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            display: ['"Space Grotesk"', 'sans-serif'],
          }
        }
      }
    }
  </script>
</head>

<body class="bg-[#030712] text-[#CBD5E1] font-sans antialiased selection:bg-[#2563EB] selection:text-white bg-grid-mesh relative overflow-x-hidden min-h-screen flex flex-col justify-between">

  <!-- Ambient Light Orbs -->
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-gradient-to-tr from-[#2563EB]/15 to-[#38BDF8]/10 blur-[130px] pointer-events-none -z-10"></div>
  <div class="fixed bottom-0 right-0 w-[600px] h-[500px] bg-gradient-to-tl from-[#0F172A]/60 via-[#2563EB]/10 to-transparent blur-[140px] pointer-events-none -z-10"></div>

  <!-- Persistent Header with Responsive Mobile Hamburger Menu -->
  <header class="sticky top-0 z-50 w-full px-4 sm:px-8 py-3.5 backdrop-blur-xl bg-[#030712]/80 border-b border-white/[0.08]">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Brand Logo pulled from public/ -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-9 h-9 min-w-[36px] max-w-[36px] h-[36px] rounded-lg bg-gradient-to-br from-[#2563EB] to-[#0F172A] border border-[#38BDF8]/40 flex items-center justify-center shadow-lg shadow-[#2563EB]/25 overflow-hidden shrink-0">
          <img 
            src="/logo.svg" 
            alt="Viewport Digital Logo" 
            class="w-full h-full object-contain p-1"
            onerror="this.onerror=null; this.src='/logo.png'; this.classList.remove('p-1');" 
          />
        </div>
        <div class="flex flex-col text-left">
          <span class="text-base font-bold font-display tracking-tight text-white group-hover:text-[#38BDF8] transition-colors leading-none">VIEWPORT DIGITAL</span>
          <span class="text-[10px] uppercase tracking-widest text-[#94A3B8]/70 font-mono mt-1">Architectural Web</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8 text-xs font-semibold uppercase tracking-wider">
        <a href="/" class={currentPath === "/" ? "text-white font-bold border-b-2 border-[#38BDF8] pb-1" : "text-[#94A3B8] hover:text-white transition-colors"}>Home</a>
        <a href="/process" class={currentPath === "/process" ? "text-white font-bold border-b-2 border-[#38BDF8] pb-1" : "text-[#94A3B8] hover:text-white transition-colors"}>Our Process</a>
        <a href="/pricing" class={currentPath === "/pricing" ? "text-white font-bold border-b-2 border-[#38BDF8] pb-1" : "text-[#94A3B8] hover:text-white transition-colors"}>Tiers & Pricing</a>
        <a href="/contact" class={currentPath === "/contact" ? "text-white font-bold border-b-2 border-[#38BDF8] pb-1" : "text-[#94A3B8] hover:text-white transition-colors"}>Contact / Let's Build</a>
      </nav>

      <!-- Desktop CTA & Mobile Hamburger Button -->
      <div class="flex items-center gap-3">
        <a href="/contact" class="hidden sm:inline-flex tactile-btn relative items-center justify-center px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-[#2563EB] hover:bg-blue-600 rounded-lg shadow-lg shadow-[#2563EB]/30 border border-[#38BDF8]/50 group">
          <span class="flex items-center gap-1.5">
            Initiate Project
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>

        <!-- Hamburger Toggle Button -->
        <button id="menu-btn" type="button" aria-label="Toggle Navigation Menu" class="md:hidden p-2 rounded-lg bg-[#0F172A] border border-white/[0.08] text-white hover:border-[#38BDF8]/50 focus:outline-none">
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Slide-Down Dropdown Menu -->
    <div id="mobile-menu" class="hidden md:hidden pt-4 pb-2 px-2 border-t border-white/[0.08] mt-3 space-y-3 font-mono text-xs uppercase tracking-wider">
      <a href="/" class="block py-2 px-3 rounded-lg hover:bg-white/[0.05] text-[#CBD5E1]">Home</a>
      <a href="/process" class="block py-2 px-3 rounded-lg hover:bg-white/[0.05] text-[#CBD5E1]">Our Process</a>
      <a href="/pricing" class="block py-2 px-3 rounded-lg hover:bg-white/[0.05] text-[#CBD5E1]">Tiers & Pricing</a>
      <a href="/contact" class="block py-2.5 px-3 rounded-lg bg-[#2563EB] text-white text-center font-bold">Contact / Let's Build &rarr;</a>
    </div>
  </header>

  <!-- Page Content Slot -->
  <main class="flex-grow">
    <slot />
  </main>

  <!-- Archival Footer -->
  <footer class="border-t border-white/[0.08] bg-[#020617] py-12 px-4 sm:px-8 text-xs font-mono text-[#94A3B8] mt-24">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <div class="w-6 h-6 rounded bg-[#2563EB]/20 border border-[#2563EB]/40 flex items-center justify-center overflow-hidden shrink-0">
          <img src="/logo.svg" alt="V" class="w-full h-full object-contain p-0.5" onerror="this.onerror=null; this.src='/logo.png';" />
        </div>
        <span class="text-white font-bold tracking-tight">VIEWPORT DIGITAL LLC</span>
        <span class="text-white/[0.15]">/</span>
        <span>ENGINEERED ARCHITECTURE</span>
      </div>

      <div class="flex items-center gap-6">
        <a href="/" class="hover:text-white transition-colors">HOME</a>
        <a href="/process" class="hover:text-white transition-colors">OUR PROCESS</a>
        <a href="/pricing" class="hover:text-white transition-colors">TIERS & PRICING</a>
        <a href="/contact" class="hover:text-white transition-colors">CONTACT</a>
      </div>

      <div>
        <span>DEPLOYED AT THE EDGE // FULL CODE OWNERSHIP</span>
      </div>
    </div>
  </footer>

  <!-- Script with NO link interception -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          const isOpen = !mobileMenu.classList.contains('hidden');
          if (isOpen) {
            mobileMenu.classList.add('hidden');
            hamburgerIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
          } else {
            mobileMenu.classList.remove('hidden');
            hamburgerIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
          }
        });
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -20px 0px' });

      document.querySelectorAll('.fade-observe').forEach(el => observer.observe(el));
    });
  </script>

</body>
</html>

<style is:global>
  .glass-panel {
    background: radial-gradient(120% 120% at 50% 0%, rgba(30, 41, 59, 0.5) 0%, rgba(11, 15, 25, 0.75) 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
  
  .glass-card-interactive {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .glass-card-interactive:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.35);
    box-shadow: 0 24px 48px -12px rgba(37, 99, 235, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .fade-observe {
    opacity: 0.94;
    transform: translateY(0);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fade-observe.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .bg-grid-mesh {
    background-size: 40px 40px;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  }

  .tactile-btn {
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tactile-btn:active {
    transform: scale(0.97);
  }

  a {
    text-decoration: none;
    color: inherit;
  }
</style>
